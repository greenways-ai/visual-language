<script is:inline>
  const setupGreenwaysControlPlane = (root) => {
    if (!(root instanceof HTMLElement) || root.dataset.greenwaysReady === "true") return;
    root.dataset.greenwaysReady = "true";

    const buttons = Array.from(root.querySelectorAll("[data-greenways-screen]"));
    const panels = Array.from(root.querySelectorAll("[data-greenways-panel]"));
    const title = root.querySelector("[data-greenways-title]");
    const breadcrumb = root.querySelector("[data-greenways-breadcrumb]");
    const primaryAction = root.querySelector("[data-greenways-primary-action]");
    const actionLabels = {
      overview: "New connection",
      keyring: "Create identity",
      packages: "Install package",
      receipts: "Export receipts",
      publish: "New release",
    };

    const activate = (screen, updateHash = true) => {
      const selected = buttons.find((button) => button.getAttribute("data-greenways-screen") === screen);
      if (!selected) return;
      root.dataset.activeScreen = screen;

      buttons.forEach((button) => {
        const active = button === selected;
        button.classList.toggle("active", active);
        button.setAttribute("aria-selected", active ? "true" : "false");
      });

      panels.forEach((panel) => {
        panel.toggleAttribute("hidden", panel.getAttribute("data-greenways-panel") !== screen);
      });

      const label = selected.textContent?.trim().replace(/\d+$/, "").trim() || "Overview";
      if (title) title.textContent = label;
      if (breadcrumb) breadcrumb.textContent = label;
      if (primaryAction) primaryAction.innerHTML = `<span aria-hidden="true">＋</span> ${actionLabels[screen] || "New"}`;
      if (updateHash) history.replaceState(null, "", `#greenways-${screen}`);
    };

    buttons.forEach((button) => {
      button.addEventListener("click", () => activate(button.getAttribute("data-greenways-screen") || "overview"));
      button.addEventListener("keydown", (event) => {
        if (!(event instanceof KeyboardEvent) || !["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) return;
        event.preventDefault();
        const current = buttons.indexOf(button);
        const direction = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1;
        const next = buttons[(current + direction + buttons.length) % buttons.length];
        if (next instanceof HTMLElement) {
          next.focus();
          activate(next.getAttribute("data-greenways-screen") || "overview");
        }
      });
    });

    const requested = location.hash.match(/^#greenways-(overview|keyring|packages|receipts|publish)$/)?.[1];
    activate(requested || root.dataset.activeScreen || "overview", false);
  };

  document.querySelectorAll("[data-greenways-control-plane]").forEach(setupGreenwaysControlPlane);
  document.addEventListener("astro:page-load", () => document.querySelectorAll("[data-greenways-control-plane]").forEach(setupGreenwaysControlPlane));
</script>
