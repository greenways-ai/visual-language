---
import type { GreenwaysScreenDefinition } from "../../greenways-product-screens";

interface Props {
  screen: GreenwaysScreenDefinition;
  position: number;
}

const { screen, position } = Astro.props;
const positionLabel = String(position + 1).padStart(2, "0");
---

<section class:list={["gw-screen", `gw-screen--${screen.tone}`]} data-greenways-screen={screen.id}>
  <header class="gw-screen-header">
    <div class="gw-screen-header__copy">
      <p class="gw-eyebrow">Screen {positionLabel} of 07 · {screen.eyebrow}</p>
      <h1>{screen.label}</h1>
      <p class="gw-screen-header__summary">{screen.summary} {screen.outcome}</p>
    </div>
    <div class="gw-screen-header__actions">
      <button class="gw-button" type="button">
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h12M10 4v12" /></svg>
        {screen.secondaryAction}
      </button>
      <button class="gw-button gw-button--primary" type="button">
        {screen.primaryAction}
        <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
      </button>
    </div>
  </header>

  {screen.id === "today" && (
    <div class="gw-today-grid">
      <div class="gw-today-main">
        <article class="gw-daily-brief">
          <div class="gw-daily-brief__top">
            <span class="gw-daily-brief__date">Wednesday · Daily brief</span>
            <span class="gw-state-chip gw-state-chip--live">Live</span>
          </div>
          <h2>Three decisions will unblock the rest of the week.</h2>
          <p>
            Review the studio release, approve the agent publishing grant and choose the campaign excerpt. Everything else is progressing inside its agreed boundary.
          </p>
          <div class="gw-daily-brief__footer">
            <button class="gw-button gw-button--primary" type="button">Begin 25 minute focus</button>
            <span class="gw-daily-brief__signal"><span aria-hidden="true"></span>Compiled from 6 workrooms and 14 receipts</span>
          </div>
        </article>

        <section class="gw-panel" aria-labelledby="today-focus-title">
          <div class="gw-panel__head">
            <span class="gw-panel__title">
              <strong id="today-focus-title">Focus</strong>
              <small>Ordered by what unblocks other work</small>
            </span>
            <button class="gw-text-button" type="button">Reorder</button>
          </div>
          <div class="gw-focus-list">
            <div class="gw-focus-item">
              <span class="gw-focus-item__check" aria-hidden="true"></span>
              <span class="gw-focus-item__copy">
                <strong>Approve “Open distribution” release candidate</strong>
                <small>Studio · requested by Mira · 9 min review</small>
              </span>
              <span class="gw-state-chip gw-state-chip--review">Review</span>
            </div>
            <div class="gw-focus-item">
              <span class="gw-focus-item__check" aria-hidden="true"></span>
              <span class="gw-focus-item__copy">
                <strong>Scope Atlas agent to campaign reporting</strong>
                <small>Keyring · grant expires in 30 days</small>
              </span>
              <span class="gw-state-chip gw-state-chip--blocked">Decision</span>
            </div>
            <div class="gw-focus-item">
              <span class="gw-focus-item__check" aria-hidden="true"></span>
              <span class="gw-focus-item__copy">
                <strong>Select the short-form campaign excerpt</strong>
                <small>Campaigns · three versions prepared</small>
              </span>
              <span class="gw-state-chip gw-state-chip--review">Review</span>
            </div>
            <div class="gw-focus-item">
              <span class="gw-focus-item__check is-done" aria-hidden="true">
                <svg viewBox="0 0 20 20"><path d="m4 10 4 4 8-8" /></svg>
              </span>
              <span class="gw-focus-item__copy">
                <strong>Confirm package namespace maintainers</strong>
                <small>Packages · completed 08:42</small>
              </span>
              <span class="gw-state-chip gw-state-chip--quiet">Done</span>
            </div>
          </div>
        </section>
      </div>

      <aside class="gw-today-rail" aria-label="Today supporting information">
        <section class="gw-panel">
          <div class="gw-panel__head">
            <span class="gw-panel__title"><strong>Active now</strong><small>People and agents in your spaces</small></span>
            <button class="gw-text-button" type="button">View map</button>
          </div>
          <div class="gw-panel__body gw-active-list">
            <div class="gw-active-row">
              <span class="gw-avatar gw-avatar--clay" aria-hidden="true">MR</span>
              <span class="gw-active-row__copy"><strong>Mira</strong><small>Reviewing the release</small></span>
              <span class="gw-online-dot" aria-label="Online"></span>
            </div>
            <div class="gw-active-row">
              <span class="gw-avatar gw-avatar--sky" aria-hidden="true">AL</span>
              <span class="gw-active-row__copy"><strong>Atlas agent</strong><small>Summarising campaign signals</small></span>
              <span class="gw-online-dot" aria-label="Online"></span>
            </div>
            <div class="gw-active-row">
              <span class="gw-avatar gw-avatar--gold" aria-hidden="true">SK</span>
              <span class="gw-active-row__copy"><strong>Suki</strong><small>In package maintainers</small></span>
              <span class="gw-online-dot" aria-label="Online"></span>
            </div>
            <div class="gw-active-row">
              <span class="gw-avatar gw-avatar--violet" aria-hidden="true">HB</span>
              <span class="gw-active-row__copy"><strong>Hara bot</strong><small>Waiting for approval</small></span>
              <span class="gw-online-dot" aria-label="Online"></span>
            </div>
          </div>
        </section>

        <section class="gw-panel">
          <div class="gw-panel__head">
            <span class="gw-panel__title"><strong>Signals</strong><small>Movement since yesterday</small></span>
          </div>
          <div class="gw-panel__body gw-signal-list">
            <div class="gw-signal">
              <span class="gw-signal__icon" aria-hidden="true">RC</span>
              <span class="gw-signal__copy"><strong>Receipts captured</strong><small>Across 4 workspaces</small></span>
              <span class="gw-signal__value">+18</span>
            </div>
            <div class="gw-signal">
              <span class="gw-signal__icon" aria-hidden="true">PK</span>
              <span class="gw-signal__copy"><strong>Package installs</strong><small>visual.canvas leads</small></span>
              <span class="gw-signal__value">+12%</span>
            </div>
            <div class="gw-signal">
              <span class="gw-signal__icon" aria-hidden="true">CP</span>
              <span class="gw-signal__copy"><strong>Campaign reach</strong><small>Verified interactions</small></span>
              <span class="gw-signal__value">8.4k</span>
            </div>
          </div>
        </section>

        <section class="gw-panel gw-snippet-card">
          <div class="gw-panel__head">
            <span class="gw-panel__title"><strong>Snippet of the day</strong><small>A small Hara pattern worth keeping</small></span>
            <button class="gw-text-button" type="button">Copy</button>
          </div>
          <pre><code>{`(defn publish-receipt [work]
  (-> work
      sign
      store
      notify))`}</code></pre>
        </section>
      </aside>
    </div>
  )}

  {screen.id === "workrooms" && (
    <section class="gw-workrooms-layout" aria-label="Selected Greenways workroom">
      <aside class="gw-room-list">
        <div class="gw-subpane-head">
          <strong>Workrooms</strong>
          <button class="gw-icon-button" type="button" aria-label="Create workroom"><svg viewBox="0 0 20 20"><path d="M4 10h12M10 4v12" /></svg></button>
        </div>
        <label class="gw-room-search">
          <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="8.5" cy="8.5" r="4.5" /><path d="m12 12 4 4" /></svg>
          <input type="search" placeholder="Find a workroom" />
        </label>
        <div class="gw-room-list__group">
          <p class="gw-room-list__label">Pinned</p>
          <button class="gw-room-row is-active" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">OR</span>
            <span class="gw-room-row__copy"><strong>Open distribution</strong><small>Release and campaign room</small></span>
            <span class="gw-room-row__count">4</span>
          </button>
          <button class="gw-room-row" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">VL</span>
            <span class="gw-room-row__copy"><strong>Visual language</strong><small>Components and screens</small></span>
            <span class="gw-room-row__count">2</span>
          </button>
          <button class="gw-room-row" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">PK</span>
            <span class="gw-room-row__copy"><strong>Package council</strong><small>Namespace stewardship</small></span>
            <span class="gw-room-row__count"></span>
          </button>
        </div>
        <div class="gw-room-list__group">
          <p class="gw-room-list__label">Recent</p>
          <button class="gw-room-row" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">AU</span>
            <span class="gw-room-row__copy"><strong>Agent onboarding</strong><small>Identity and permissions</small></span>
            <span class="gw-room-row__count">1</span>
          </button>
          <button class="gw-room-row" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">MU</span>
            <span class="gw-room-row__copy"><strong>Music prototype</strong><small>Portable performance format</small></span>
            <span class="gw-room-row__count"></span>
          </button>
          <button class="gw-room-row" type="button">
            <span class="gw-room-row__glyph" aria-hidden="true">RS</span>
            <span class="gw-room-row__copy"><strong>Registry research</strong><small>Accreditation model</small></span>
            <span class="gw-room-row__count"></span>
          </button>
        </div>
      </aside>

      <div class="gw-room-thread">
        <header class="gw-room-thread__head">
          <span class="gw-room-title">
            <strong>Open distribution</strong>
            <small>6 people · 3 agents · private workroom</small>
          </span>
          <span class="gw-room-thread__actions">
            <span class="gw-mini-avatar-stack" aria-label="Four active members">
              <span class="gw-avatar gw-avatar--chris">CZ</span>
              <span class="gw-avatar gw-avatar--clay">MR</span>
              <span class="gw-avatar gw-avatar--sky">AL</span>
              <span class="gw-avatar gw-avatar--gold">SK</span>
            </span>
            <button class="gw-icon-button" type="button" aria-label="Workroom call"><svg viewBox="0 0 20 20"><path d="M6 5h5a3 3 0 0 1 3 3v4a3 3 0 0 1-3 3H6a3 3 0 0 1-3-3V8a3 3 0 0 1 3-3Z" /><path d="m14 9 3-2v6l-3-2" /></svg></button>
            <button class="gw-icon-button" type="button" aria-label="Workroom settings"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="2.5" /><path d="M10 3v2M10 15v2M3 10h2M15 10h2M5.05 5.05l1.42 1.42M13.53 13.53l1.42 1.42M14.95 5.05l-1.42 1.42M6.47 13.53l-1.42 1.42" /></svg></button>
          </span>
        </header>

        <div class="gw-thread-feed">
          <div class="gw-thread-day">Today</div>
          <article class="gw-message">
            <span class="gw-avatar gw-avatar--clay" aria-hidden="true">MR</span>
            <div class="gw-message__body">
              <div class="gw-message__meta"><strong>Mira</strong><span>09:08</span></div>
              <p>I tightened the release narrative around portable publishing. The new version explains the value before it introduces the registry.</p>
              <div class="gw-message-card">
                <div class="gw-message-card__head"><strong>Open distribution · Release 04</strong><span class="gw-state-chip gw-state-chip--review">Ready for review</span></div>
                <p>Source, attribution and permitted derivatives travel together. Platforms receive a publishable package instead of another opaque upload.</p>
              </div>
            </div>
          </article>
          <article class="gw-message">
            <span class="gw-avatar gw-avatar--sky" aria-hidden="true">AL</span>
            <div class="gw-message__body">
              <div class="gw-message__meta"><strong>Atlas agent</strong><span>09:12 · acting for Chris</span></div>
              <p>I compared Release 04 with the campaign brief. The claims now align. One phrase still needs a source before external distribution.</p>
              <div class="gw-message-card">
                <div class="gw-message-card__head"><strong>Evidence request</strong><span class="gw-state-chip gw-state-chip--blocked">1 missing source</span></div>
                <p>Attach the campaign measurement note to “measurable across platforms”, or soften the sentence.</p>
              </div>
            </div>
          </article>
          <article class="gw-message">
            <span class="gw-avatar gw-avatar--chris" aria-hidden="true">CZ</span>
            <div class="gw-message__body">
              <div class="gw-message__meta"><strong>Chris</strong><span>09:19</span></div>
              <p>Keep the sentence. I attached the measurement note and asked Atlas to prepare a receipt linking the claim, source and approval.</p>
            </div>
          </article>
        </div>

        <form class="gw-composer">
          <textarea aria-label="Write to the workroom" placeholder="Write a message, ask an agent or drop a file…"></textarea>
          <div class="gw-composer__footer">
            <span class="gw-composer__tools">
              <button type="button" aria-label="Attach file"><svg viewBox="0 0 20 20"><path d="m7 10 4.2-4.2a2.4 2.4 0 0 1 3.4 3.4l-5.4 5.4a3.5 3.5 0 0 1-5-5L9 4.8" /></svg></button>
              <button type="button" aria-label="Mention a person or agent"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6.5" /><path d="M12.5 8.5v3a2 2 0 0 0 4 0V10a6.5 6.5 0 1 0-2 4.7" /><circle cx="9.5" cy="10" r="2.5" /></svg></button>
              <button type="button" aria-label="Add an action"><svg viewBox="0 0 20 20"><path d="M5 4.5h10v11H5zM7.5 8h5M7.5 11h3" /></svg></button>
            </span>
            <button class="gw-button gw-button--primary" type="submit">Send</button>
          </div>
        </form>
      </div>

      <aside class="gw-room-details">
        <div class="gw-subpane-head"><strong>Room details</strong><button class="gw-kebab-button" type="button" aria-label="More room actions">···</button></div>
        <section class="gw-room-details__section">
          <div class="gw-detail-title"><strong>People and agents</strong><button class="gw-text-button" type="button">Manage</button></div>
          <div class="gw-member-list">
            <div class="gw-member-row"><span class="gw-avatar gw-avatar--chris">CZ</span><span class="gw-member-row__copy"><strong>Chris</strong><small>Owner</small></span><span class="gw-member-role">person</span></div>
            <div class="gw-member-row"><span class="gw-avatar gw-avatar--clay">MR</span><span class="gw-member-row__copy"><strong>Mira</strong><small>Editor</small></span><span class="gw-member-role">person</span></div>
            <div class="gw-member-row"><span class="gw-avatar gw-avatar--sky">AL</span><span class="gw-member-row__copy"><strong>Atlas</strong><small>Campaign analysis</small></span><span class="gw-member-role">agent</span></div>
            <div class="gw-member-row"><span class="gw-avatar gw-avatar--violet">HB</span><span class="gw-member-row__copy"><strong>Hara bot</strong><small>Package notices</small></span><span class="gw-member-role">agent</span></div>
          </div>
        </section>
        <section class="gw-room-details__section">
          <div class="gw-detail-title"><strong>Shared files</strong><button class="gw-text-button" type="button">See all 12</button></div>
          <div class="gw-file-list">
            <div class="gw-file-row"><span class="gw-file-row__glyph">HAL</span><span class="gw-file-row__copy"><strong>release-04.hal</strong><small>Updated 7 min ago</small></span></div>
            <div class="gw-file-row"><span class="gw-file-row__glyph">PDF</span><span class="gw-file-row__copy"><strong>measurement-note.pdf</strong><small>Attached by Chris</small></span></div>
            <div class="gw-file-row"><span class="gw-file-row__glyph">MD</span><span class="gw-file-row__copy"><strong>campaign-brief.md</strong><small>Verified source</small></span></div>
          </div>
        </section>
        <section class="gw-room-details__section">
          <div class="gw-detail-title"><strong>Room policy</strong></div>
          <p class="gw-recovery-note">Agents may read shared material. Publishing, external messaging and new grants require a person.</p>
        </section>
      </aside>
    </section>
  )}

  {screen.id === "studio" && (
    <section class="gw-studio-shell" aria-label="Greenways publication studio">
      <header class="gw-studio-toolbar">
        <span class="gw-studio-toolbar__group">
          <button class="gw-tool-button is-active" type="button"><svg viewBox="0 0 20 20"><path d="m5 3 9 7-4 1-2 4Z" /></svg>Select</button>
          <button class="gw-tool-button" type="button"><svg viewBox="0 0 20 20"><path d="M4 5h12v10H4z" /></svg>Frame</button>
          <button class="gw-tool-button" type="button"><svg viewBox="0 0 20 20"><path d="M5 15 10 4l5 11M7 11h6" /></svg>Text</button>
          <button class="gw-tool-button" type="button"><svg viewBox="0 0 20 20"><circle cx="10" cy="10" r="6" /></svg>Shape</button>
          <button class="gw-tool-button" type="button"><svg viewBox="0 0 20 20"><path d="M3 14.5 7.5 10l3 3 2-2 4.5 3.5M4 4h12v12H4z" /></svg>Media</button>
        </span>
        <span class="gw-studio-toolbar__group">
          <span class="gw-state-chip gw-state-chip--live">Saved</span>
          <button class="gw-tool-button" type="button">Preview</button>
          <button class="gw-button gw-button--primary" type="button">Publish</button>
        </span>
      </header>

      <aside class="gw-studio-assets">
        <div class="gw-asset-tabs"><button class="is-active" type="button">Assets</button><button type="button">Files</button><button type="button">Data</button></div>
        <section class="gw-asset-section">
          <span class="gw-meta-label">Release media</span>
          <div class="gw-asset-grid">
            <article class="gw-asset-card"><div class="gw-asset-card__preview"></div><span>forest-cover.jpg</span></article>
            <article class="gw-asset-card"><div class="gw-asset-card__preview"></div><span>registry-map.svg</span></article>
            <article class="gw-asset-card"><div class="gw-asset-card__preview"></div><span>creator-still.jpg</span></article>
            <article class="gw-asset-card"><div class="gw-asset-card__preview"></div><span>receipt-flow.svg</span></article>
          </div>
        </section>
        <section class="gw-asset-section">
          <span class="gw-meta-label">Reusable blocks</span>
          <div class="gw-file-list" style="margin-top: 10px">
            <div class="gw-file-row"><span class="gw-file-row__glyph">HD</span><span class="gw-file-row__copy"><strong>Editorial header</strong><small>Shared component</small></span></div>
            <div class="gw-file-row"><span class="gw-file-row__glyph">QT</span><span class="gw-file-row__copy"><strong>Evidence quote</strong><small>Includes source</small></span></div>
            <div class="gw-file-row"><span class="gw-file-row__glyph">RC</span><span class="gw-file-row__copy"><strong>Receipt footer</strong><small>Automatic metadata</small></span></div>
          </div>
        </section>
      </aside>

      <div class="gw-studio-canvas">
        <article class="gw-artboard" aria-label="Open distribution cover design">
          <div class="gw-artboard__copy">
            <span>Greenways field note 04</span>
            <h2>Open distribution, with the work still attached.</h2>
            <p>A portable publication carries source, attribution and accountable change across every destination.</p>
          </div>
          <div class="gw-artboard__image"></div>
          <div class="gw-selection-box" aria-hidden="true"><span></span><span></span><span></span><span></span></div>
        </article>
        <div class="gw-canvas-zoom"><button type="button" aria-label="Zoom out">−</button><span>74%</span><button type="button" aria-label="Zoom in">+</button></div>
      </div>

      <aside class="gw-studio-inspector">
        <div class="gw-inspector-tabs"><button class="is-active" type="button">Design</button><button type="button">Receipt</button></div>
        <section class="gw-inspector-section">
          <div class="gw-inspector-section__head"><strong>Position</strong><button class="gw-kebab-button" type="button" aria-label="Position options">···</button></div>
          <div class="gw-control-grid">
            <div class="gw-control"><label>X</label><span>42</span></div><div class="gw-control"><label>Y</label><span>82</span></div>
            <div class="gw-control"><label>W</label><span>248</span></div><div class="gw-control"><label>H</label><span>164</span></div>
          </div>
        </section>
        <section class="gw-inspector-section">
          <div class="gw-inspector-section__head"><strong>Typography</strong><span class="gw-meta-label">Heading / L</span></div>
          <div class="gw-control-grid">
            <div class="gw-control" style="grid-column: 1 / -1"><label>Typeface</label><span>Manrope 560</span></div>
            <div class="gw-control"><label>Size</label><span>48</span></div><div class="gw-control"><label>Line</label><span>1.03</span></div>
          </div>
          <div class="gw-inspector-toggle"><span>Optical balance</span><span class="gw-toggle" aria-hidden="true"></span></div>
        </section>
        <section class="gw-inspector-section">
          <div class="gw-inspector-section__head"><strong>Source relationship</strong><span class="gw-state-chip gw-state-chip--live">Attached</span></div>
          <p class="gw-recovery-note">This headline derives from <strong>release-04.hal</strong>. Changes remain linked to the approved source.</p>
        </section>
        <section class="gw-inspector-section">
          <div class="gw-inspector-section__head"><strong>Destinations</strong></div>
          <div class="gw-package-compat"><span class="gw-chip">Web</span><span class="gw-chip">Newsletter</span><span class="gw-chip">Social</span><span class="gw-chip">Archive</span></div>
        </section>
      </aside>

      <footer class="gw-studio-statusbar">
        <span><span>Release 04</span><span>Canvas 1600 × 1000</span><span>sRGB</span></span>
        <span><span>4 sources</span><span>2 reviewers</span><span>Receipt ready</span></span>
      </footer>
    </section>
  )}

  {screen.id === "campaigns" && (
    <div>
      <section class="gw-campaign-metrics" aria-label="Campaign measures">
        <article class="gw-metric-card"><div class="gw-metric-card__top"><span>Verified reach</span><span class="gw-metric-card__trend">+14.2%</span></div><strong>84,260</strong><small>Across owned and partner channels</small></article>
        <article class="gw-metric-card"><div class="gw-metric-card__top"><span>Meaningful actions</span><span class="gw-metric-card__trend">+8.7%</span></div><strong>6,418</strong><small>Saves, replies and package visits</small></article>
        <article class="gw-metric-card"><div class="gw-metric-card__top"><span>Collaborators</span><span class="gw-metric-card__trend">12 active</span></div><strong>28</strong><small>5 publishers · 7 creators · 16 agents</small></article>
        <article class="gw-metric-card"><div class="gw-metric-card__top"><span>Evidence coverage</span><span class="gw-metric-card__trend">+6 pts</span></div><strong>96%</strong><small>Of reported outcomes have a receipt</small></article>
      </section>

      <div class="gw-campaign-grid">
        <div class="gw-campaign-main">
          <article class="gw-campaign-hero">
