---
import DocumentationHeader from "../../DocumentationHeader.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const searchBase = base.replace(/\/$/, "");
---

<DocumentationHeader
  project="greenways"
  title="Visual Language"
  homeHref={base}
  docsHref={`${base}foundations/principles/`}
  docsLabel="Docs"
  nav={[
    { label: "Concepts", href: `${base}concepts/` },
    { label: "Day & night", href: `${base}identity/day-night/` },
    { label: "Case studies", href: `${base}case-studies/` },
  ]}
  searchBase={searchBase}
  searchLabel="Search Visual Language documentation"
  logoAssetBase={`${base}favicons`}
  logoAssetVersion="peacock-feather-20260810"
/>
