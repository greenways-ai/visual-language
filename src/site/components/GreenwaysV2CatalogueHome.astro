---
import CatalogueShell from "../../v2/CatalogueShell.astro";
import { catalogueHref, greenwaysV2CatalogueHome } from "../../v2/catalogue-manifest.js";
import { visualLayoutSections } from "../../v2/visual-layout-manifest.js";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const href = (path: string) => catalogueHref(path, basePath);
---

<CatalogueShell
  title={greenwaysV2CatalogueHome.label}
  description={greenwaysV2CatalogueHome.summary}
  currentPath={currentPath}
  canonicalPath={catalogueHref("/", basePath)}
  bodyClass="gw-v2-directory-body"
  mainClass="gw-v2-directory-main"
  sectionNavigation={false}
  showVisualNavigator={false}
  showRail={false}
  showRouteBar={false}
  useFlameMark={true}
>
  <main class="gw-v2-directory" data-gw-v2-visual-layout-root>
    <div class="gw-v2-directory-shader" aria-hidden="true">
      <span class="gw-v2-directory-shader__orb gw-v2-directory-shader__orb--a"></span>
      <span class="gw-v2-directory-shader__orb gw-v2-directory-shader__orb--b"></span>
      <span class="gw-v2-directory-shader__orb gw-v2-directory-shader__orb--c"></span>
      <span class="gw-v2-directory-shader__grain"></span>
    </div>
    <header class="gw-v2-directory__intro">
      <p class="gw-v2-catalogue-eyebrow">Greenways visual language · v2</p>
      <h1>Visual layout.</h1>
      <p>Four places to begin. Each section opens into its own system of documentation, interfaces, wireframes, and working material.</p>
    </header>

    <nav class="gw-v2-directory__sections" aria-label="Visual language sections">
      {visualLayoutSections.map((section, index) => (
        <a class:list={["gw-v2-directory-card", `gw-v2-directory-card--${section.id}`]} href={href(section.hubPath)}>
          <span class="gw-v2-directory-card__index">{String(index + 1).padStart(2, "0")}</span>
          <span class="gw-v2-directory-card__icon" aria-hidden="true">
            {section.icon === "spark" && <svg viewBox="0 0 24 24"><path d="M12 2.5 14 10l7.5 2-7.5 2-2 7.5-7.5-2 7.5-2Z" /></svg>}
            {section.icon === "layers" && <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5-8 4.5-8-4.5Z" /><path d="m4 12 8 4.5 8-4.5M4 16.5l8 4.5 8-4.5" /></svg>}
            {section.icon === "grid" && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1.5" /><rect x="14" y="4" width="6" height="6" rx="1.5" /><rect x="4" y="14" width="6" height="6" rx="1.5" /><rect x="14" y="14" width="6" height="6" rx="1.5" /></svg>}
            {section.icon === "network" && <svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="m8.3 10.8 7.4-3.6M8.3 13.2l7.4 3.6" /></svg>}
          </span>
          <span class="gw-v2-directory-card__copy">
            <small>{section.label} · section {String(index + 1).padStart(2, "0")}</small>
            <strong>{section.label}</strong>
            <span>{section.summary}</span>
          </span>
          <span class="gw-v2-directory-card__count">{section.routes.length} routes <b>↗</b></span>
        </a>
      ))}
    </nav>

    <footer class="gw-v2-directory__footer">
      <span>Brand / OS / Product / Infra</span>
      <span>v2 framework · in progress</span>
    </footer>

    <details class="gw-v2-directory-host">
      <summary aria-label="Open the visual language host">
        <span class="gw-v2-directory-host__face" aria-hidden="true"><i></i><i></i><b></b></span>
        <span class="gw-v2-directory-host__label">Need a way in?</span>
      </summary>
      <div class="gw-v2-directory-host__bubble">
        <strong>Start with a section.</strong>
        <span>I’ll keep the atlas warm while it grows.</span>
      </div>
    </details>
  </main>
</CatalogueShell>
