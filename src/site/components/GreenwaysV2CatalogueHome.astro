---
import CatalogueShell from "../../v2/CatalogueShell.astro";
import { catalogueHref, greenwaysV2CatalogueHome } from "../../v2/catalogue-manifest.js";
import {
  visualLayoutDestinationKinds,
  visualLayoutSections,
} from "../../v2/visual-layout-manifest.js";

interface Props {
  currentPath?: string;
}

const { currentPath = Astro.url.pathname } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const href = (path: string) => catalogueHref(path, basePath);
const artwork = (path: string) => `${basePath.replace(/\/+$/, "")}/artwork/${path}`;
const visualWorlds = [
  {
    project: "Greenways",
    label: "Peacock garden",
    route: "/concepts/greenways/",
    day: "greenways/peacock-garden-day.webp",
    night: "greenways/peacock-garden-night.webp",
  },
  {
    project: "Hodos",
    label: "Reflecting pool",
    route: "/concepts/hodos/",
    day: "hodos/reflecting-pool-day.webp",
    night: "hodos/reflecting-pool-night.webp",
  },
  {
    project: "Tahto",
    label: "Paired observatories",
    route: "/concepts/tahto/",
    day: "tahto/paired-observatories-day.webp",
    night: "tahto/paired-observatories-night.webp",
  },
  {
    project: "Hestia",
    label: "Recovery room",
    route: "/concepts/hestia/",
    day: "hestia/recovery-room-day.webp",
    night: "hestia/recovery-room-night.webp",
  },
  {
    project: "Historia",
    label: "Raven library",
    route: "/concepts/historia/",
    day: "historia/raven-library-day.webp",
    night: "historia/raven-library-night.webp",
  },
  {
    project: "Hoplite",
    label: "Open horizon",
    route: "/concepts/hoplite/",
    day: "hoplite/open-horizon-day.webp",
    night: "hoplite/open-horizon-night.webp",
  },
];

const destinationHref = (route: { path?: string; external?: boolean }) =>
  route.path ? (route.external ? route.path : href(route.path)) : undefined;
const statusLabel = (status: string) => status === "placeholder" ? "Coming later" : status;
---

<CatalogueShell
  title={greenwaysV2CatalogueHome.label}
  description={greenwaysV2CatalogueHome.summary}
  currentPath={currentPath}
  canonicalPath={catalogueHref("/", basePath)}
  bodyClass="gw-v2-atlas-body"
>
  <header id="catalogue-overview" data-catalogue-section data-section-label="Overview" class="gw-v2-catalogue-hero">
    <div class="gw-v2-catalogue-hero__art" aria-hidden="true">
      <img class="mode-light" src={artwork("greenways/peacock-garden-day.webp")} alt="" loading="eager" decoding="async" />
      <img class="mode-dark" src={artwork("greenways/peacock-garden-night.webp")} alt="" loading="eager" decoding="async" />
    </div>
    <div class="gw-v2-catalogue-hero__copy">
      <p class="gw-v2-catalogue-eyebrow">Greenways visual language · executable atlas</p>
      <h1>One language.<br />Many places to live.</h1>
      <p>
        A calm visual index for Greenways themes, the OS Fabric, product studies, and the infrastructure that carries
        the work. Open a route at full scale, or stay here to compare the family at a glance.
      </p>
      <div class="gw-v2-catalogue-hero__actions">
        <a class="gw-v2-button gw-v2-button--primary" href="#visual-layout-themes">Explore themes</a>
        <a class="gw-v2-button" href="#visual-layout-os">Open the OS</a>
      </div>
    </div>
  </header>

  <div id="visual-layout-map" class="gw-v2-visual-layout-root" data-gw-v2-visual-layout-root>
    {visualLayoutSections.map((section) => (
      <section
        id={`visual-layout-${section.id}`}
        data-catalogue-section
        data-section-label={section.label}
        class:list={["gw-v2-root-section", `gw-v2-root-section--${section.id}`]}
        aria-labelledby={`visual-layout-${section.id}-title`}
      >
        <header class="gw-v2-root-section__header">
          <div class="gw-v2-root-section__identity">
            <span class="gw-v2-root-section__icon" aria-hidden="true">{section.shortLabel.slice(0, 2).toUpperCase()}</span>
            <div>
              <p class="gw-v2-catalogue-eyebrow">{section.id}</p>
              <h2 id={`visual-layout-${section.id}-title`}>{section.label}</h2>
            </div>
          </div>
          <p>{section.summary}</p>
        </header>

        <div class="gw-v2-root-section__routes">
          {section.routes.map((route) => route.path ? (
            <a
              class="gw-v2-visual-layout-destination"
              href={destinationHref(route)}
              data-kind={route.kind}
              data-status={route.status}
              data-external={route.external ? "true" : undefined}
            >
              <span class="gw-v2-visual-layout-destination__meta">
                {visualLayoutDestinationKinds[route.kind]} · {statusLabel(route.status)}
              </span>
              <strong>{route.label}</strong>
              <span>{route.summary}</span>
              <small>{route.external ? "Open documentation ↗" : "Open route →"}</small>
            </a>
          ) : (
            <article
              class="gw-v2-visual-layout-destination gw-v2-visual-layout-destination--placeholder"
              data-kind={route.kind}
              data-status={route.status}
              aria-label={`${route.label}, placeholder`}
            >
              <span class="gw-v2-visual-layout-destination__meta">
                {visualLayoutDestinationKinds[route.kind]} · {statusLabel(route.status)}
              </span>
              <strong>{route.label}</strong>
              <span>{route.summary}</span>
              <small>Route to be defined</small>
            </article>
          ))}
        </div>

        {section.id === "themes" && (
          <section class="gw-v2-root-worlds" aria-labelledby="visual-worlds-title">
            <header>
              <div>
                <p class="gw-v2-catalogue-eyebrow">Backgrounds · textures · moods</p>
                <h3 id="visual-worlds-title">The language has places to live.</h3>
              </div>
              <p>Earlier generated worlds remain available as a visual moodboard for future themes and product surfaces.</p>
            </header>
            <div class="gw-v2-visual-layout-gallery__grid">
              {visualWorlds.map((world) => (
                <a class="gw-v2-visual-layout-artwork" href={href(world.route)}>
                  <span class="gw-v2-visual-layout-artwork__image">
                    <img class="mode-light" src={artwork(world.day)} alt="" loading="lazy" decoding="async" />
                    <img class="mode-dark" src={artwork(world.night)} alt="" loading="lazy" decoding="async" />
                  </span>
                  <span class="gw-v2-visual-layout-artwork__meta">{world.project} · visual study</span>
                  <strong>{world.label}</strong>
                </a>
              ))}
            </div>
          </section>
        )}
      </section>
    ))}
  </div>
</CatalogueShell>
