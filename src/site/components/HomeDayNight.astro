---
import DayNightExplorer from "./DayNightExplorer.astro";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---
<section class="home-section" id="day-night">
  <header>
    <p class="panel-label">03 · Day and night</p>
    <h2>One place.<br />Two living states.</h2>
    <p>Night is designed from the accepted day master. It changes illumination and behaviour without moving the world underneath.</p>
  </header>
  <DayNightExplorer
    title="World Confluence"
    eyebrow="Greenways.ai world study"
    world="www"
    scene="world-confluence"
    dayAlt="The connected Greenways world confluence in daylight, with rivers, bridges, gardens, and wildlife"
    nightAlt="The same connected Greenways world confluence at night, with restrained civic lights and resting wildlife"
    dayCaption="Routes, habitats, water, and public life are immediately legible."
    nightCaption="The same geography becomes a field of lanterns, reflections, roosts, and quiet movement."
    locked={["Camera, horizon, rivers, bridges, districts, and mosaic patterns", "The relationship between civic, cultivated, and wild space"]}
    changes={["Natural light, practical light, reflections, weather, and atmosphere", "Credible day activity and nocturnal rest or movement"]}
    href={`${base}concepts/www/world-confluence/`}
    linkLabel="Open concept page"
  />
</section>
