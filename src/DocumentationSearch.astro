---
interface Props {
  id?: string;
  label?: string;
  placeholder?: string;
  searchBase?: string;
  opener?: string;
  maxResults?: number;
}

const {
  id = "gw-documentation-search",
  label = "Search documentation",
  placeholder = label,
  searchBase = "",
  opener = "[data-gw-documentation-search-open]",
  maxResults = 8,
} = Astro.props;
---

<dialog
  id={id}
  class="gw-documentation-search"
  data-gw-documentation-search
  data-search-base={searchBase.replace(/\/$/, "")}
  data-open-selector={opener}
  data-max-results={String(maxResults)}
  aria-label={label}
>
  <form method="dialog" class="gw-documentation-search__bar">
    <label>
      <span class="gw-documentation-search__sr">{label}</span>
      <svg viewBox="0 0 24 24" aria-hidden="true">
        <circle cx="11" cy="11" r="6.5" />
        <path d="m16 16 4.25 4.25" />
      </svg>
      <input
        type="search"
        data-gw-documentation-search-input
        autocomplete="off"
        placeholder={placeholder}
      />
    </label>
    <button type="submit" value="close">Close</button>
  </form>
  <div
    class="gw-documentation-search__results"
    data-gw-documentation-search-results
    aria-live="polite"
  >
    <p>Begin typing to search this documentation.</p>
  </div>
</dialog>

<script>
  const initialiseDocumentationSearch = (dialog: HTMLDialogElement) => {
    if (dialog.dataset.initialised === "true") return;
    dialog.dataset.initialised = "true";

    const input = dialog.querySelector<HTMLInputElement>("[data-gw-documentation-search-input]");
    const results = dialog.querySelector<HTMLElement>("[data-gw-documentation-search-results]");
    const selector = dialog.dataset.openSelector || "[data-gw-documentation-search-open]";
    const maxResults = Number.parseInt(dialog.dataset.maxResults || "8", 10);
    let searchEngine: any;

    const open = () => {
      if (!dialog.open) dialog.showModal();
      requestAnimationFrame(() => input?.focus());
    };

    document.querySelectorAll(selector).forEach((trigger) => {
      trigger.addEventListener("click", open);
    });

    input?.addEventListener("input", async () => {
      const term = input.value.trim();
      if (!results) return;

      if (term.length < 2) {
        results.innerHTML = term.length === 0
          ? "<p>Begin typing to search this documentation.</p>"
          : "<p>Type at least two characters.</p>";
        return;
      }

      try {
        if (!searchEngine) {
          const base = dialog.dataset.searchBase || "";
          searchEngine = await import(/* @vite-ignore */ `${base}/pagefind/pagefind.js`);
        }

        const found = await searchEngine.search(term);
        const entries = await Promise.all(
          found.results.slice(0, maxResults).map((result: any) => result.data()),
        );

        results.replaceChildren(...entries.map((entry: any) => {
          const link = document.createElement("a");
          const title = document.createElement("strong");
          const excerpt = document.createElement("span");
          link.href = entry.url;
          title.textContent = entry.meta.title || "Result";
          excerpt.innerHTML = entry.excerpt || "";
          link.append(title, excerpt);
          return link;
        }));

        if (!entries.length) results.innerHTML = "<p>No results found.</p>";
      } catch {
        results.innerHTML = "<p>Search is unavailable in this preview.</p>";
      }
    });

    window.addEventListener("keydown", (event) => {
      if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === "k") {
        event.preventDefault();
        open();
      }
    });
  };

  document
    .querySelectorAll<HTMLDialogElement>("[data-gw-documentation-search]")
    .forEach(initialiseDocumentationSearch);
</script>

<style>
  .gw-documentation-search {
    position: fixed;
    inset: 50% auto auto 50%;
    width: min(calc(100% - 32px), 760px);
    max-width: none;
    max-height: min(80svh, 720px);
    margin: 0;
    padding: 0;
    overflow: hidden;
    color: var(--gw-text);
    background: var(--gw-surface);
    border: 1px solid var(--gw-line-strong);
    border-radius: 18px;
    box-shadow: 0 32px 100px rgba(0, 0, 0, .32);
    transform: translate(-50%, -50%);
  }

  .gw-documentation-search:not([open]) { display: none; }

  .gw-documentation-search::backdrop {
    background: rgba(2, 8, 6, .62);
    backdrop-filter: blur(5px);
  }

  .gw-documentation-search__bar {
    display: flex;
    gap: 10px;
    padding: 12px;
    border-bottom: 1px solid var(--gw-line);
  }

  .gw-documentation-search__bar label {
    min-width: 0;
    flex: 1;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 0 14px;
    background: var(--gw-control-bg);
    border: 1px solid var(--gw-line-strong);
    border-radius: 10px;
  }

  .gw-documentation-search__bar svg {
    width: 20px;
    height: 20px;
    flex: 0 0 auto;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .gw-documentation-search__bar input {
    width: 100%;
    min-height: 48px;
    color: var(--gw-text);
    background: transparent;
    border: 0;
    outline: 0;
    font: inherit;
  }

  .gw-documentation-search__bar button {
    min-height: 48px;
    padding: 0 16px;
    color: var(--gw-control-text);
    background: var(--gw-control-bg);
    border: 1px solid var(--gw-line-strong);
    border-radius: 10px;
    cursor: pointer;
    font: inherit;
  }

  .gw-documentation-search__bar button:hover,
  .gw-documentation-search__results :global(a:hover) {
    background: var(--gw-control-hover);
  }

  .gw-documentation-search__bar :is(input, button):focus-visible,
  .gw-documentation-search__results :global(a:focus-visible) {
    outline: 3px solid var(--gw-focus);
    outline-offset: 2px;
  }

  .gw-documentation-search__results {
    max-height: min(62svh, 580px);
    display: grid;
    gap: 8px;
    padding: 12px;
    overflow: auto;
  }

  .gw-documentation-search__results > p {
    margin: 0;
    padding: 20px;
    color: var(--gw-text-muted);
  }

  .gw-documentation-search__results :global(a) {
    display: grid;
    gap: 4px;
    padding: 14px;
    color: var(--gw-text);
    border-radius: 10px;
    text-decoration: none;
  }

  .gw-documentation-search__results :global(span) {
    color: var(--gw-text-muted);
    font-size: .85rem;
  }

  .gw-documentation-search__sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  @media (max-width: 560px) {
    .gw-documentation-search {
      width: calc(100% - 20px);
      max-height: calc(100svh - 20px);
    }

    .gw-documentation-search__bar { align-items: stretch; }
    .gw-documentation-search__bar label { padding-inline: 10px; }
    .gw-documentation-search__bar button {
      width: 52px;
      overflow: hidden;
      padding: 0;
      font-size: 0;
    }
    .gw-documentation-search__bar button::after {
      content: "×";
      font-size: 1.25rem;
    }
  }
</style>
