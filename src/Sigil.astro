---
type Project = "greenways" | "hestia" | "hoplite" | "historia" | "historian" | "hodos";
type Props = { project?: Project; label?: string; class?: string };
const { project = "greenways", label = project, class: className = "" } = Astro.props;
const resolved = project === "historian" ? "historia" : project;
---
<svg class:list={["gw-sigil", `gw-sigil--${resolved}`, className]} viewBox="0 0 64 64" role="img" aria-label={`${label} sigil`}>
  <rect class="gw-sigil__ground" x="1" y="1" width="62" height="62" rx="11" />
  {resolved === "hestia" && <g class="gw-sigil__tiles"><path d="M32 5C20 20 15 29 17 43c2 10 8 15 15 17-4-8-3-15 1-22 3 6 7 10 6 17 8-6 11-15 7-26C43 19 36 11 32 5Z"/><path d="M32 16c-7 10-10 18-8 27 1 7 4 12 8 17-4-8-3-15 1-22Z"/><path d="M33 38c-4 7-5 15-1 22 5-2 8-7 7-12 0-4-3-8-6-10Z"/></g>}
  {resolved === "hoplite" && <g class="gw-sigil__tiles"><path d="M7 19c11-8 23-9 33-4l-8 8c-7-3-15-1-22 4Z"/><path d="M39 15c8 3 14 2 19-2-2 10-10 15-21 13l-5-3Z"/><path d="M5 34c14-8 29-8 40-2l-8 7c-9-4-20-3-29 2Z"/><path d="M45 32c6 3 11 2 15-1-3 8-10 13-19 11l-4-3Z"/><path d="M12 49c10-5 21-5 30-1l-8 7c-6-3-13-2-19 1Z"/></g>}
  {resolved === "historia" && <g class="gw-sigil__tiles"><path d="M4 32C12 18 21 12 32 12L22 25 14 32Z"/><path d="M32 12c11 0 21 6 28 20H50l-8-7Z"/><path d="M4 32h10l8 7 10 13C20 52 11 45 4 32Z"/><path d="M60 32H50l-8 7-10 13c12 0 21-7 28-20Z"/><path class="gw-sigil__iris" d="m32 20 11 7 3 5-7 9-7 5-7-5-7-9 3-5Z"/><path class="gw-sigil__pupil" d="m32 26 6 4 1 3-4 6-3 1-3-1-4-6 1-3Z"/></g>}
  {resolved === "hodos" && <g class="gw-sigil__tiles"><path d="M31 27C22 12 11 10 7 15c2 12 9 20 22 22Z"/><path d="M33 27c9-15 20-17 24-12-2 12-9 20-22 22Z"/><path d="M29 36C17 34 10 40 12 48c7 6 13 7 19 3Z"/><path d="M35 36c12-2 19 4 17 12-7 6-13 7-19 3Z"/><path class="gw-sigil__body" d="m32 20 4 10-2 25h-4l-2-25Z"/><path class="gw-sigil__body" d="m29 20-5-7M35 20l5-7"/></g>}
  {resolved === "greenways" && <g class="gw-sigil__tiles"><path d="M32 7 42 21 32 30 22 21Z"/><path d="m44 22 13 8-13 9-10-7Z"/><path d="m44 41 9 12-17-3-2-15Z"/><path d="m30 35-2 15-17 3 9-12Z"/><path d="M20 39 7 30l13-8 10 10Z"/><path class="gw-sigil__eye" d="M20 31c6-9 18-9 24 0-6 10-18 10-24 0Z"/><path class="gw-sigil__pupil" d="m32 25 6 6-6 7-6-7Z"/></g>}
</svg>
