---
type Project = "greenways" | "hestia" | "hoplite" | "historia" | "historian" | "hodos";
type Props = { project?: Project; label?: string; class?: string };
const { project = "greenways", label = project, class: className = "" } = Astro.props;
const resolved = project === "historian" ? "historia" : project;
---
<svg class:list={["gw-sigil", `gw-sigil--${resolved}`, className]} viewBox="0 0 64 64" role="img" aria-label={`${label} sigil`}>
  <rect class="gw-sigil__ground" x="1" y="1" width="62" height="62" rx="11" />
  {resolved === "hestia" && <g class="gw-sigil__tiles"><path class="gw-sigil__c2" d="M32 10.7 36.9 22.2 48.5 17.5 43.8 29.1 55.3 34 43.8 38.9 48.5 50.5 36.9 45.8 32 57.3 27.1 45.8 15.5 50.5 20.2 38.9 8.7 34 20.2 29.1 15.5 17.5 27.1 22.2Z"/><path class="gw-sigil__eye" d="M25.1 34a6.9 6.9 0 1 0 13.9 0 6.9 6.9 0 1 0-13.9 0Z"/></g>}
  {resolved === "hoplite" && <g class="gw-sigil__tiles"><path class="gw-sigil__c3" d="M32 9.3 36 30 56.7 34 36 38 32 58.7 28 38 7.3 34 28 30Z"/><path class="gw-sigil__eye" d="M26.1 34a5.9 5.9 0 1 0 11.7 0 5.9 5.9 0 1 0-11.7 0Z"/></g>}
  {resolved === "historia" && <g class="gw-sigil__tiles"><path class="gw-sigil__iris" d="M35.7 20a8.3 8.3 0 1 0 16.5 0 8.3 8.3 0 1 0-16.5 0Z"/><path class="gw-sigil__c2" d="M6.7 52 24 21.3 41.3 52Z"/><path class="gw-sigil__c3" d="M28 52 42.7 29.3 57.3 52Z"/></g>}
  {resolved === "hodos" && <g class="gw-sigil__tiles"><path class="gw-sigil__c2" fill-rule="evenodd" d="M8.7 33.3a23.3 23.3 0 1 0 46.7 0 23.3 23.3 0 1 0-46.7 0ZM13.1 33.3a18.9 18.9 0 1 0 37.9 0 18.9 18.9 0 1 0-37.9 0Z"/><path class="gw-sigil__c4" fill-rule="evenodd" d="M18.7 33.3a13.3 13.3 0 1 0 26.7 0 13.3 13.3 0 1 0-26.7 0ZM23.2 33.3a8.8 8.8 0 1 0 17.6 0 8.8 8.8 0 1 0-17.6 0Z"/></g>}
  {resolved === "greenways" && <g class="gw-sigil__tiles"><path class="gw-sigil__c1" d="M32 12C52.7 24.3 52.7 43.7 32 56 11.3 43.7 11.3 24.3 32 12Z"/><path class="gw-sigil__c3" d="M32 18C46.5 27 46.5 41 32 50 17.5 41 17.5 27 32 18Z"/><path class="gw-sigil__c4" d="M32 23.7C41.1 29.5 41.1 38.5 32 44.3 22.9 38.5 22.9 29.5 32 23.7Z"/><path class="gw-sigil__iris" d="M32 28.9C36.3 31.8 36.3 36.2 32 39.1 27.7 36.2 27.7 31.8 32 28.9Z"/></g>}
</svg>
