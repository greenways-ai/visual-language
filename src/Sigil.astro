---
type Project =
  | "greenways"
  | "hestia"
  | "hoplite"
  | "historia"
  | "historian"
  | "hodos"
  | "visual-language"
  | "statstrade";
type Props = {
  project?: Project;
  label?: string;
  class?: string;
  assetBase?: string;
};

const {
  project = "greenways",
  label = project,
  class: className = "",
  assetBase = "https://oss.greenways.ai/visual-language/favicons",
} = Astro.props;
const resolved = project === "historian" ? "historia" : project;
const root = assetBase.replace(/\/+$/, "");
---

{resolved === "statstrade" ? (
  <svg
    class:list={["gw-sigil", "gw-sigil--statstrade", className]}
    viewBox="0 0 64 64"
    role="img"
    aria-label={`${label} sigil`}
  >
    <rect class="gw-sigil__ground" x="1" y="1" width="62" height="62" rx="11" />
    <g class="gw-sigil__tiles" transform="translate(5.5 5.4) scale(.68)">
      <path class="gw-sigil__c4" d="M18.8177 0.159851H68.8281C69.4874 0.159851 69.9663 0.786772 69.7928 1.42289L64.782 19.8013C64.6634 20.2364 64.2682 20.5382 63.8173 20.5382H46.4022C45.7269 20.5382 45.2457 19.8826 45.4483 19.2383L46.3983 16.2165C46.6009 15.5723 46.1197 14.9166 45.4443 14.9166H34.1335C33.6848 14.9166 33.291 15.2155 33.1703 15.6476L30.7854 24.1882C30.6073 24.8257 31.0866 25.4571 31.7485 25.4571H75.2024C75.8582 25.4571 76.3365 26.0778 76.1694 26.7119L72.808 39.4687C72.6923 39.9079 72.2952 40.2139 71.841 40.2139H60.1214C59.6679 40.2139 59.2711 40.5191 59.1548 40.9574L49.4787 77.4164C49.3624 77.8547 48.9657 78.1599 48.5122 78.1599H30.8038C30.1419 78.1599 29.6626 77.5282 29.8407 76.8907L32.6663 66.7804C32.8444 66.1428 32.3651 65.5112 31.7032 65.5112H1.80465C1.14669 65.5112 0.668036 64.8867 0.839002 64.2514L5.78431 45.873C5.90181 45.4363 6.29775 45.1328 6.74996 45.1328H23.8168C24.468 45.1328 24.9455 45.7453 24.7866 46.3768L23.9983 49.5105C23.8395 50.142 24.3169 50.7544 24.9681 50.7544H36.1384C36.5927 50.7544 36.9899 50.4482 37.1055 50.0088L39.3519 41.4683C39.5187 40.8342 39.0404 40.2139 38.3848 40.2139H8.52276C7.86423 40.2139 7.38549 39.5884 7.55746 38.9528L17.8524 0.898705C17.9703 0.46267 18.3659 0.159851 18.8177 0.159851Z" />
    </g>
  </svg>
) : (
  <span
    class:list={["gw-sigil", "gw-sigil--asset", `gw-sigil--${resolved}`, className]}
    role="img"
    aria-label={`${label} sigil`}
  >
    <img
      class="gw-sigil__asset gw-sigil__asset--light"
      src={`${root}/${resolved}-light.svg`}
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
    <img
      class="gw-sigil__asset gw-sigil__asset--dark"
      src={`${root}/${resolved}-dark.svg`}
      alt=""
      aria-hidden="true"
      loading="eager"
      decoding="async"
    />
  </span>
)}

<style>
  .gw-sigil--asset {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    overflow: hidden;
    padding: 3px;
    background: var(--gw-sigil-ground);
    border: 1px solid var(--gw-line-strong);
    border-radius: 18%;
  }

  .gw-sigil__asset {
    grid-area: 1 / 1;
    width: 100%;
    height: 100%;
    display: block;
    object-fit: contain;
  }

  .gw-sigil__asset--dark { display: none; }
  :global(:root[data-theme="dark"]) .gw-sigil__asset--light { display: none; }
  :global(:root[data-theme="dark"]) .gw-sigil__asset--dark { display: block; }
</style>
