---
import DocumentationSearch from "./DocumentationSearch.astro";
import ProjectSwitcher from "./ProjectSwitcher.astro";
import ThemeButton from "./ThemeButton.astro";
import { visualLayoutSections } from "./v2/visual-layout-manifest.js";

type Project = "greenways" | "hestia" | "hoplite" | "historia" | "hodos" | "tahto" | "ignatius" | "visual-language" | "statstrade";
type NavItem = { label: string; href: string };
interface Props {
  project?: Project;
  title: string;
  homeHref?: string;
  docsHref?: string;
  docsLabel?: string;
  nav?: NavItem[];
  searchBase?: string;
  searchLabel?: string;
  logoAssetBase?: string;
  logoAssetVersion?: string;
  showProjectBackLink?: boolean;
}

const {
  project = "greenways",
  title,
  homeHref = "/",
  docsHref,
  docsLabel = "Docs",
  nav = [],
  searchBase = "",
  searchLabel = `Search ${title} documentation`,
  logoAssetBase,
  logoAssetVersion,
  showProjectBackLink = true,
} = Astro.props;
const searchSelector = `[data-gw-documentation-search-open="${project}"]`;
const visualHref = (path: string, external = false) => external ? path : `${homeHref.replace(/\/+$/, "")}/${path.replace(/^\/+/, "")}`;
---

<header class="gw-documentation-header" data-gw-documentation-header>
  <div class="gw-documentation-header__brand">
    <ProjectSwitcher
      project={project}
      label={title}
      assetBase={logoAssetBase}
      assetVersion={logoAssetVersion}
      showBackLink={showProjectBackLink}
    />
    <a href={homeHref}>{title}</a>
  </div>

  {(nav.length > 0 || docsHref) && (
    <nav aria-label={`${title} documentation navigation`}>
      {nav.map((item) => <a href={item.href}>{item.label}</a>)}
      {docsHref && <a href={docsHref}>{docsLabel}</a>}
    </nav>
  )}

  <details class="gw-documentation-header__navigator">
    <summary aria-label="Open visual navigator"><span>Visual navigator</span><b aria-hidden="true">＋</b></summary>
    <div class="gw-documentation-header__navigator-panel">
      <header><div><p>Greenways visual language · v2</p><h2>Visual navigator</h2></div><span>Brand / OS / Product / Infra</span></header>
      <nav aria-label="Greenways visual language sections">
        {visualLayoutSections.map((section) => (
          <section>
            <a class="gw-documentation-header__navigator-section" href={visualHref(section.hubPath)}><strong>{section.label}</strong><small>Open section ↗</small></a>
            {section.routes.slice(0, 4).map((route) => route.path ? <a class="gw-documentation-header__navigator-route" href={visualHref(route.path, route.external)}>{route.label}</a> : <span class="gw-documentation-header__navigator-route is-placeholder">{route.label}</span>)}
          </section>
        ))}
      </nav>
    </div>
  </details>

  <button
    class="gw-documentation-header__control"
    type="button"
    data-gw-documentation-search-open={project}
    aria-label={searchLabel}
    title={`${searchLabel} (⌘K)`}
  >
    <svg viewBox="0 0 24 24" aria-hidden="true">
      <circle cx="11" cy="11" r="6.5" />
      <path d="m16 16 4.25 4.25" />
    </svg>
  </button>

  <ThemeButton />
</header>

<DocumentationSearch
  id={`gw-${project}-documentation-search`}
  label={searchLabel}
  placeholder={searchLabel}
  searchBase={searchBase}
  opener={searchSelector}
/>

<style>
  .gw-documentation-header {
    position: sticky;
    z-index: 70;
    top: 0;
    min-height: 76px;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto auto;
    align-items: center;
    gap: clamp(10px, 1.5vw, 22px);
    padding: 12px clamp(16px, 3vw, 46px);
    color: var(--gw-text);
    background: var(--gw-header);
    border-block: 1px solid var(--gw-line);
    backdrop-filter: blur(18px);
  }

  .gw-documentation-header__brand {
    min-width: 0;
    display: flex;
    align-items: center;
    gap: 12px;
  }

  .gw-documentation-header__brand > a {
    overflow: hidden;
    color: inherit;
    text-overflow: ellipsis;
    white-space: nowrap;
    font: 400 clamp(1.25rem, 2vw, 1.85rem) "Marcellus", Georgia, serif;
    letter-spacing: .075em;
    text-decoration: none;
  }

  .gw-documentation-header nav {
    min-width: 0;
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: clamp(12px, 2vw, 26px);
  }

  .gw-documentation-header nav a {
    color: inherit;
    font: 700 .68rem "Manrope", system-ui, sans-serif;
    letter-spacing: .08em;
    text-decoration: none;
    text-transform: uppercase;
    white-space: nowrap;
  }

  .gw-documentation-header nav a:hover { color: var(--gw-accent-3); }

  .gw-documentation-header__navigator { position: relative; justify-self: end; }
  .gw-documentation-header__navigator > summary { min-height: 48px; display: inline-flex; align-items: center; gap: 8px; padding: 0 12px; color: var(--gw-control-text); background: var(--gw-control-bg); border: 1px solid var(--gw-line-strong); border-radius: 10px; cursor: pointer; font: 700 .66rem "Manrope", system-ui, sans-serif; letter-spacing: .06em; text-transform: uppercase; list-style: none; }
  .gw-documentation-header__navigator > summary::-webkit-details-marker { display: none; }
  .gw-documentation-header__navigator > summary:hover { background: var(--gw-control-hover); }
  .gw-documentation-header__navigator > summary b { display: grid; place-items: center; width: 20px; height: 20px; border: 1px solid var(--gw-line-strong); border-radius: 50%; font-size: 1rem; font-weight: 400; line-height: 1; }
  .gw-documentation-header__navigator[open] > summary b { transform: rotate(45deg); }
  .gw-documentation-header__navigator-panel { position: fixed; z-index: 120; inset-block-start: max(12px, env(safe-area-inset-top)); inset-inline-end: max(12px, env(safe-area-inset-right)); box-sizing: border-box; width: min(620px, calc(100vw - 24px)); max-height: calc(100svh - 24px); display: grid; grid-template-rows: auto minmax(0, 1fr); gap: 18px; padding: clamp(18px, 3vw, 30px); overflow: auto; color: var(--gw-text); background: var(--visual-panel-solid); border: 1px solid var(--gw-line-strong); border-radius: 20px; box-shadow: 0 30px 100px rgba(0,0,0,.28); }
  .gw-documentation-header__navigator-panel header { display: flex; align-items: end; justify-content: space-between; gap: 20px; padding-bottom: 16px; border-bottom: 1px solid var(--gw-line); }
  .gw-documentation-header__navigator-panel header p { margin: 0 0 5px; color: var(--visual-peacock); font: .6rem var(--sl-font-mono); letter-spacing: .08em; text-transform: uppercase; }
  .gw-documentation-header__navigator-panel header h2 { margin: 0; font: 400 clamp(1.8rem, 4vw, 3.4rem) "Marcellus", Georgia, serif; letter-spacing: -.05em; }
  .gw-documentation-header__navigator-panel header > span { color: var(--visual-muted); font: .62rem var(--sl-font-mono); text-transform: uppercase; }
  .gw-documentation-header__navigator-panel nav { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); align-content: start; gap: 10px; }
  .gw-documentation-header__navigator-panel section { padding: 10px; border: 1px solid var(--gw-line); border-radius: 12px; }
  .gw-documentation-header__navigator-section { display: flex; align-items: center; justify-content: space-between; gap: 8px; padding-bottom: 8px; color: var(--visual-peacock); border-bottom: 1px solid var(--gw-line); text-decoration: none; }
  .gw-documentation-header__navigator-section small { font: .58rem var(--sl-font-mono); }
  .gw-documentation-header__navigator-route { display: block; padding-top: 8px; color: var(--gw-text); font-size: .73rem; text-decoration: none; }
  .gw-documentation-header__navigator-route:hover { color: var(--gw-accent-3); }
  .gw-documentation-header__navigator-route.is-placeholder { color: var(--visual-muted); }

  .gw-documentation-header__control {
    width: 48px;
    height: 48px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    color: var(--gw-control-text);
    background: var(--gw-control-bg);
    border: 1px solid var(--gw-line-strong);
    border-radius: 10px;
    cursor: pointer;
  }

  .gw-documentation-header__control:hover { background: var(--gw-control-hover); }
  .gw-documentation-header__control:focus-visible,
  .gw-documentation-header a:focus-visible {
    outline: 3px solid var(--gw-focus);
    outline-offset: 3px;
  }

  .gw-documentation-header__control svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  @media (max-width: 900px) {
    .gw-documentation-header nav a:not(:last-child) { display: none; }
    .gw-documentation-header__navigator > summary span { display: none; }
    .gw-documentation-header__navigator > summary { width: 48px; justify-content: center; padding: 0; }
  }

  @media (max-width: 560px) {
    .gw-documentation-header {
      min-height: 68px;
      gap: 8px;
      padding: 9px 10px;
    }

    .gw-documentation-header__brand { gap: 9px; }
    .gw-documentation-header__brand > a { font-size: 1.05rem; }
    .gw-documentation-header nav a { font-size: .61rem; }
    .gw-documentation-header__control { width: 44px; height: 44px; }
    .gw-documentation-header__navigator > summary { width: 44px; min-height: 44px; }
    .gw-documentation-header__navigator-panel nav { grid-template-columns: 1fr; }
  }
</style>
