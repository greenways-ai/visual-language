---
import "../components.css";

type CellValue = string | number | null | undefined;
type Alignment = "start" | "center" | "end";
interface DataColumn { key: string; label: string; align?: Alignment; }
interface Props {
  caption: string;
  columns: readonly DataColumn[];
  rows: readonly Record<string, CellValue>[];
  emptyMessage?: string;
  class?: string;
}
const { caption, columns, rows, emptyMessage = "No records to compare.", class: className = "" } = Astro.props;
---
<div
  class:list={["gw-v2-component", "gw-v2-table-wrap", className]}
  data-gw-v2-component="DataTable"
  data-gw-v2-state={rows.length === 0 ? "empty" : "initial"}
>
  <table class="gw-v2-table">
    <caption>{caption}</caption>
    <thead>
      <tr>{columns.map((column) => <th scope="col" data-align={column.align ?? "start"}>{column.label}</th>)}</tr>
    </thead>
    <tbody>
      {rows.length === 0 ? (
        <tr><td class="gw-v2-table__empty" colspan={columns.length}>{emptyMessage}</td></tr>
      ) : rows.map((row) => (
        <tr>
          {columns.map((column, index) => index === 0 ? (
            <th scope="row" data-label={column.label} data-align={column.align ?? "start"}>{row[column.key] ?? "—"}</th>
          ) : (
            <td data-label={column.label} data-align={column.align ?? "start"}>{row[column.key] ?? "—"}</td>
          ))}
        </tr>
      ))}
    </tbody>
  </table>
</div>
