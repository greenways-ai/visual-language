---
import { catalogueHref, isCatalogueRouteCurrent } from "./catalogue-manifest.js";
import { getCatalogueRouteContext } from "./catalogue-navigation.js";

interface Props {
  currentPath: string;
  basePath?: string;
}

const { currentPath, basePath = import.meta.env.BASE_URL } = Astro.props;
const context = getCatalogueRouteContext(currentPath, basePath);
const href = (path: string) => catalogueHref(path, basePath);
const isCurrent = (path: string) => isCatalogueRouteCurrent(path, currentPath, basePath);
---

{context && (
  <section
    class="gw-v2-catalogue-route-bar"
    aria-label="Current catalogue location"
    data-gw-v2-catalogue-route-bar
    data-group={context.group.id}
    data-route={context.item.id}
  >
    <div class="gw-v2-catalogue-route-identity">
      <a class="gw-v2-catalogue-parent-link" href={href(context.parentTarget.path)}>
        <span aria-hidden="true">←</span>
        <span>{context.parent ? context.parent.label : "Catalogue"}</span>
      </a>

      <nav class="gw-v2-catalogue-breadcrumbs" aria-label="Breadcrumb">
        {context.breadcrumbs.map((crumb, index) => (
          <Fragment>
            {index > 0 && <span class="gw-v2-catalogue-breadcrumb-separator" aria-hidden="true">/</span>}
            {crumb.current
              ? <strong aria-current="page">{crumb.label}</strong>
              : crumb.path
                ? <a href={href(crumb.path)}>{crumb.label}</a>
                : <span data-breadcrumb-kind={crumb.kind}>{crumb.label}</span>}
          </Fragment>
        ))}
      </nav>
    </div>

    {context.siblings.length > 1 && (
      <nav class="gw-v2-catalogue-family-tabs" aria-label={`${context.familyLabel} routes`}>
        {context.siblings.map((route) => (
          <a
            href={href(route.path)}
            aria-current={isCurrent(route.path) ? "page" : undefined}
            data-status={route.status}
            data-ownership={route.ownership}
          >
            <span>{route.label}</span>
            {route.status === "planned" && <small>Planned</small>}
            {route.status === "exploration" && <small>Exploration</small>}
          </a>
        ))}
      </nav>
    )}

    <div class="gw-v2-catalogue-route-tools" aria-label="Route status">
      <span data-status={context.item.status}>{context.statusLabel}</span>
      <span data-ownership={context.item.ownership}>{context.ownershipLabel}</span>
      {context.item.issue && (
        <a href={`https://github.com/greenways-ai/visual-language/issues/${context.item.issue}`}>#{context.item.issue}</a>
      )}
    </div>
  </section>
)}
