---
import MosaicLogo from "../MosaicLogo.astro";
import ThemeButton from "../ThemeButton.astro";
import {
  catalogueHref,
  greenwaysV2CatalogueHome,
  isCatalogueRouteCurrent,
} from "./catalogue-manifest.js";
import {
  visualLayoutDestinationKinds,
  visualLayoutSections,
} from "./visual-layout-manifest.js";

interface Props {
  currentPath: string;
  basePath?: string;
  showVisualNavigator?: boolean;
  showRail?: boolean;
}

const {
  currentPath,
  basePath = import.meta.env.BASE_URL,
  showVisualNavigator = true,
  showRail = false,
} = Astro.props;

const href = (path: string) => catalogueHref(path, basePath);
const isCurrent = (path: string) => isCatalogueRouteCurrent(path, currentPath, basePath);
const visualHref = (path: string, external = false) => external ? path : href(path);
const routeIsCurrent = (path?: string, external = false) => Boolean(path && !external && currentPath.startsWith(path.split("#")[0]));
const sectionIsCurrent = (section: (typeof visualLayoutSections)[number]) =>
  currentPath === section.hubPath || currentPath.startsWith(`${section.hubPath.replace(/\/$/, "")}/`) || section.routes.some((route) => routeIsCurrent(route.path, route.external));
---

<header
  class="gw-v2-catalogue-header"
  data-gw-v2-catalogue-header
  data-gw-v2-visual-navigator={showVisualNavigator ? "true" : undefined}
  data-gw-v2-rail-enabled={showRail ? "true" : undefined}
>
  <a
    class="gw-v2-catalogue-brand"
    href={href(greenwaysV2CatalogueHome.path)}
    aria-current={isCurrent(greenwaysV2CatalogueHome.path) ? "page" : undefined}
  >
    <MosaicLogo project="greenways" label="Greenways" class="gw-v2-catalogue-brand__mark" />
    <span>
      <strong>Greenways</strong>
      <small>Visual language · v2</small>
    </span>
  </a>

  <div class="gw-v2-catalogue-folio" aria-label="Catalogue character">
    <span>Executable atlas</span>
    <strong>Brand · OS · Product · Infra</strong>
  </div>

  {showRail && <nav id="gw-v2-catalogue-rail" class="gw-v2-catalogue-rail" aria-label="Visual language sections" data-gw-v2-catalogue-rail>
    <div class="gw-v2-catalogue-rail__items">
      {visualLayoutSections.map((section) => (
        <a
          class="gw-v2-catalogue-rail__link"
          href={visualHref(section.hubPath)}
          data-section={section.id}
          aria-label={section.label}
          title={section.label}
        >
          <span class="gw-v2-catalogue-rail__icon" aria-hidden="true">
            {section.icon === "spark" && <svg viewBox="0 0 24 24"><path d="M12 2.5 14 10l7.5 2-7.5 2-2 7.5-2-7.5-7.5-2 7.5-2Z" /></svg>}
            {section.icon === "layers" && <svg viewBox="0 0 24 24"><path d="m12 3 8 4.5-8 4.5-8-4.5Z" /><path d="m4 12 8 4.5 8-4.5" /><path d="m4 16.5 8 4.5 8-4.5" /></svg>}
            {section.icon === "grid" && <svg viewBox="0 0 24 24"><rect x="4" y="4" width="6" height="6" rx="1.5" /><rect x="14" y="4" width="6" height="6" rx="1.5" /><rect x="4" y="14" width="6" height="6" rx="1.5" /><rect x="14" y="14" width="6" height="6" rx="1.5" /></svg>}
            {section.icon === "network" && <svg viewBox="0 0 24 24"><circle cx="6" cy="12" r="2.5" /><circle cx="18" cy="6" r="2.5" /><circle cx="18" cy="18" r="2.5" /><path d="m8.3 10.8 7.4-3.6M8.3 13.2l7.4 3.6" /></svg>}
          </span>
          <span class="gw-v2-catalogue-rail__label">{section.label}</span>
        </a>
      ))}
    </div>
    <button class="gw-v2-catalogue-rail__toggle" type="button" data-gw-v2-rail-toggle aria-expanded="false" aria-label="Expand section navigation">
      <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5 16 12 9 19" /></svg>
    </button>
  </nav>}

  {showRail && <button
    class="gw-v2-catalogue-mobile-toggle"
    type="button"
    data-gw-v2-mobile-nav-toggle
    aria-controls="gw-v2-catalogue-rail"
    aria-expanded="false"
    aria-label="Open section navigation"
  >
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
  </button>}

  {showVisualNavigator && <details class="gw-v2-catalogue-nav" data-gw-v2-catalogue-nav data-gw-v2-atlas-index>
    <summary>
      <span>Visual navigator</span>
      <span aria-hidden="true">＋</span>
    </summary>

    <div class="gw-v2-catalogue-nav__body">
      <header class="gw-v2-catalogue-nav__masthead">
        <div>
          <p>Greenways visual language · v2</p>
          <h2>Visual navigator</h2>
          <span>Move between the four sections without leaving the current visual system.</span>
        </div>
        <button type="button" data-gw-v2-catalogue-close>
          <span>Close</span>
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <nav aria-label="Greenways visual language sections">
        <ul class="gw-v2-catalogue-nav__groups">
          {visualLayoutSections.map((section, groupIndex) => {
            const active = sectionIsCurrent(section);
            return (
              <li>
                <details
                  class="gw-v2-catalogue-nav__group"
                  data-current={active ? "true" : undefined}
                  open={active}
                >
                  <summary>
                    <span class="gw-v2-catalogue-nav__group-code">{String(groupIndex + 1).padStart(2, "0")}</span>
                    <span>{section.label}</span>
                    <small>{section.routes.length}</small>
                  </summary>
                  <ul class="gw-v2-catalogue-nav__routes">
                    <li data-primary="true" data-ownership="visual-language">
                      <a href={visualHref(section.hubPath)} aria-current={currentPath === section.hubPath ? "page" : undefined}>
                        <span>Section overview</span>
                        <small>Directory</small>
                      </a>
                    </li>
                    {section.routes.map((route) => route.path ? (
                      <li data-primary="true" data-ownership="visual-language">
                        <a href={visualHref(route.path, route.external)} aria-current={routeIsCurrent(route.path, route.external) ? "page" : undefined}>
                          <span>{route.label}</span>
                          <small>{visualLayoutDestinationKinds[route.kind]}</small>
                        </a>
                      </li>
                    ) : (
                      <li data-primary="true" data-ownership="visual-language">
                        <span class="gw-v2-catalogue-nav__placeholder"><span>{route.label}</span><small>Placeholder</small></span>
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })}
        </ul>
      </nav>

      <footer class="gw-v2-catalogue-nav__footer">
        <span>Current layer</span>
        <strong>Brand · OS · Product · Infra</strong>
        <small>Every section can grow independently while sharing the same v2 visual contract.</small>
      </footer>
    </div>
  </details>}

  <ThemeButton />
</header>
