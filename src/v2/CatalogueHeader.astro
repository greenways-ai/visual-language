---
import MosaicLogo from "../MosaicLogo.astro";
import ThemeButton from "../ThemeButton.astro";
import {
  catalogueHref,
  catalogueStatusLabels,
  greenwaysV2Catalogue,
  greenwaysV2CatalogueHome,
  isCatalogueRouteActive,
  isCatalogueRouteCurrent,
} from "./catalogue-manifest.js";

interface Props {
  currentPath: string;
  basePath?: string;
}

const {
  currentPath,
  basePath = import.meta.env.BASE_URL,
} = Astro.props;

const href = (path: string) => catalogueHref(path, basePath);
const isCurrent = (path: string) => isCatalogueRouteCurrent(path, currentPath, basePath);
const isActive = (path: string) => isCatalogueRouteActive(path, currentPath, basePath);
const groupIsActive = (routes: (typeof greenwaysV2Catalogue)[number]["routes"]) =>
  routes.some((route) => isActive(route.path) || route.children?.some((child) => isActive(child.path)));

const quickRoutes = [
  {
    id: "overview",
    label: "Overview",
    path: greenwaysV2CatalogueHome.path,
    matches: [greenwaysV2CatalogueHome.path],
    exact: true,
  },
  {
    id: "foundations",
    label: "Foundations",
    path: "/v2/foundations/",
    matches: ["/v2/foundations/"],
    exact: false,
  },
  {
    id: "library",
    label: "Library",
    path: "/v2/library/",
    matches: ["/v2/library/"],
    exact: false,
  },
  {
    id: "spaces",
    label: "Spaces",
    path: "/v2/applications/greenways-suite/desktop/",
    matches: ["/v2/applications/greenways-suite/desktop/"],
    exact: false,
  },
  {
    id: "flow",
    label: "Flow",
    path: "/v2/applications/greenways-suite/browser/",
    matches: [
      "/v2/applications/greenways-suite/browser/",
      "/v2/applications/foreman/",
    ],
    exact: false,
  },
] as const;

const quickRouteIsActive = (route: (typeof quickRoutes)[number]) =>
  route.exact
    ? isCurrent(route.path)
    : route.matches.some((path) => isActive(path));
---

<header class="gw-v2-catalogue-header" data-gw-v2-catalogue-header>
  <a
    class="gw-v2-catalogue-brand"
    href={href(greenwaysV2CatalogueHome.path)}
    aria-current={isCurrent(greenwaysV2CatalogueHome.path) ? "page" : undefined}
  >
    <MosaicLogo project="greenways" label="Greenways" class="gw-v2-catalogue-brand__mark" />
    <span>
      <strong>Greenways</strong>
      <small>Visual language · v2</small>
    </span>
  </a>

  <div class="gw-v2-catalogue-folio" aria-label="Catalogue character">
    <span>Executable atlas</span>
    <strong>System · applications · surfaces</strong>
  </div>

  <nav class="gw-v2-catalogue-quick-nav" aria-label="Visual language sections" data-gw-v2-quick-nav>
    {quickRoutes.map((route) => (
      <a
        href={href(route.path)}
        aria-current={isCurrent(route.path) ? "page" : undefined}
        data-active={quickRouteIsActive(route) ? "true" : undefined}
        data-quick-route={route.id}
      >
        {route.label}
      </a>
    ))}
  </nav>

  <details class="gw-v2-catalogue-nav" data-gw-v2-catalogue-nav data-gw-v2-atlas-index>
    <summary>
      <span>Atlas index</span>
      <span aria-hidden="true">＋</span>
    </summary>

    <div class="gw-v2-catalogue-nav__body">
      <header class="gw-v2-catalogue-nav__masthead">
        <div>
          <p>Greenways visual language · v2</p>
          <h2>Atlas index</h2>
          <span>Browse by visual layer. Open a specimen at full scale.</span>
        </div>
        <button type="button" data-gw-v2-catalogue-close>
          <span>Close</span>
          <span aria-hidden="true">×</span>
        </button>
      </header>

      <nav aria-label="Greenways v2 catalogue">
        <ul class="gw-v2-catalogue-nav__groups">
          {greenwaysV2Catalogue.map((group, groupIndex) => {
            const active = groupIsActive(group.routes);
            return (
              <li>
                <details
                  class="gw-v2-catalogue-nav__group"
                  data-current={active ? "true" : undefined}
                  open={active}
                >
                  <summary>
                    <span class="gw-v2-catalogue-nav__group-code">
                      {String(groupIndex + 1).padStart(2, "0")}
                    </span>
                    <span>{group.label}</span>
                    <small>{group.routes.length}</small>
                  </summary>
                  <ul class="gw-v2-catalogue-nav__routes">
                    {group.routes.map((route) => (
                      <li
                        data-primary={route.primary === false ? "false" : "true"}
                        data-ownership={route.ownership}
                      >
                        <a
                          href={href(route.path)}
                          aria-current={isCurrent(route.path) ? "page" : undefined}
                        >
                          <span>{route.label}</span>
                          <small>{catalogueStatusLabels[route.status]}</small>
                        </a>
                        {route.children && route.children.length > 0 && (
                          <ul>
                            {route.children.map((child) => (
                              <li
                                data-primary={child.primary === false ? "false" : "true"}
                                data-ownership={child.ownership}
                              >
                                <a
                                  href={href(child.path)}
                                  aria-current={isCurrent(child.path) ? "page" : undefined}
                                >
                                  <span>{child.label}</span>
                                  <small>{catalogueStatusLabels[child.status]}</small>
                                </a>
                              </li>
                            ))}
                          </ul>
                        )}
                      </li>
                    ))}
                  </ul>
                </details>
              </li>
            );
          })}
        </ul>
      </nav>

      <footer class="gw-v2-catalogue-nav__footer">
        <span>Current applications</span>
        <strong>Spaces · Flow</strong>
        <small>Catalogue metadata remains available here, outside the specimen frame.</small>
      </footer>
    </div>
  </details>

  <ThemeButton />
</header>
