---
import GreenwaysThemeProvider from "../site/components/GreenwaysThemeProvider.astro";
import CatalogueNavigation from "./CatalogueNavigation.astro";
import CataloguePageFooter from "./CataloguePageFooter.astro";
import { catalogueHref } from "./catalogue-manifest.js";
import greenwaysV2DelicateMaterialCss from "./catalogue-material.css?raw";
import "./document.css";
import "./catalogue.css";
import "./catalogue-atlas.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  canonicalPath?: string;
  bodyClass?: string;
  mainClass?: string;
  sectionNavigation?: boolean;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  canonicalPath = Astro.url.pathname,
  bodyClass,
  mainClass,
  sectionNavigation = true,
} = Astro.props;

const basePath = import.meta.env.BASE_URL;
const base = catalogueHref("/", basePath);
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(canonicalPath, origin).toString();
---

<!doctype html>
<html lang="en" data-project="visual-language" data-gw-v2-atlas-frame>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Greenways visual language`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title} · Greenways visual language</title>
    <GreenwaysThemeProvider />
    <style
      is:inline
      data-greenways-v2-delicate-material
      set:html={greenwaysV2DelicateMaterialCss}
    ></style>
  </head>
  <body
    class:list={["gw-v2", "gw-v2-document", "gw-v2-catalogue", "gw-v2-atlas-frame", bodyClass]}
    data-gw-v2-current-path={currentPath}
    data-gw-v2-material="delicate"
  >
    <CatalogueNavigation
      currentPath={currentPath}
      basePath={basePath}
      sectionNavigation={sectionNavigation}
    />

    <main
      id="gw-v2-main"
      class:list={["gw-v2-catalogue-main", "gw-v2-page", mainClass]}
      tabindex="-1"
    >
      <slot />
      <CataloguePageFooter currentPath={currentPath} basePath={basePath} />
    </main>

    <footer class="gw-v2-catalogue-footer">
      <span>Greenways visual language · executable atlas</span>
      <a href="https://github.com/greenways-ai/visual-language">Source ↗</a>
    </footer>
  </body>
</html>
