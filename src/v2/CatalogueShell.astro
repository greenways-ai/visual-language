---
import GreenwaysThemeProvider from "../site/components/GreenwaysThemeProvider.astro";
import CatalogueNavigation from "./CatalogueNavigation.astro";
import CataloguePageFooter from "./CataloguePageFooter.astro";
import { catalogueHref } from "./catalogue-manifest.js";
import greenwaysFabricResponsiveCss from "./greenways-platform-homepage-responsive.css?raw";
import greenwaysFabricEditorialCss from "./greenways-platform-homepage-editorial.css?raw";
import "./document.css";
import "./catalogue.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
  bodyClass?: string;
  mainClass?: string;
  sectionNavigation?: boolean;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
  bodyClass,
  mainClass,
  sectionNavigation = true,
} = Astro.props;

const basePath = import.meta.env.BASE_URL;
const base = catalogueHref("/", basePath);
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).toString();
const fabricHomepagePath = "/v2/applications/greenways-platform/homepage/";
const isGreenwaysFabricHomepage =
  currentPath === fabricHomepagePath || currentPath.endsWith(fabricHomepagePath);
---

<!doctype html>
<html lang="en" data-project="visual-language">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Greenways visual language`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title} · Greenways visual language</title>
    <GreenwaysThemeProvider />
    {isGreenwaysFabricHomepage && (
      <>
        <style
          is:inline
          data-greenways-fabric-responsive-cascade
          set:html={greenwaysFabricResponsiveCss}
        ></style>
        <style
          is:inline
          data-greenways-fabric-editorial-calibration
          set:html={greenwaysFabricEditorialCss}
        ></style>
      </>
    )}
  </head>
  <body class:list={["gw-v2", "gw-v2-document", "gw-v2-catalogue", bodyClass]}>
    <CatalogueNavigation
      currentPath={currentPath}
      basePath={basePath}
      sectionNavigation={sectionNavigation}
    />

    <main id="gw-v2-main" class:list={["gw-v2-catalogue-main", "gw-v2-page", mainClass]} tabindex="-1">
      <slot />
      <CataloguePageFooter currentPath={currentPath} basePath={basePath} />
    </main>

    <footer class="gw-v2-catalogue-footer">
      <span>Greenways visual language · v2 catalogue</span>
      <a href="https://github.com/greenways-ai/visual-language">Source ↗</a>
    </footer>
  </body>
</html>
