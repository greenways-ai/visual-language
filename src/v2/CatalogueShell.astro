---
import GreenwaysThemeProvider from "../site/components/GreenwaysThemeProvider.astro";
import CatalogueHeader from "./CatalogueHeader.astro";
import { catalogueHref } from "./catalogue-manifest.js";
import "./document.css";
import "./catalogue.css";

interface Props {
  title: string;
  description: string;
  currentPath?: string;
}

const {
  title,
  description,
  currentPath = Astro.url.pathname,
} = Astro.props;

const basePath = import.meta.env.BASE_URL;
const base = catalogueHref("/", basePath);
const origin = Astro.site ?? new URL(Astro.url.origin);
const canonical = new URL(Astro.url.pathname, origin).toString();
---

<!doctype html>
<html lang="en" data-project="visual-language">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${title} · Greenways visual language`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <title>{title} · Greenways visual language</title>
    <GreenwaysThemeProvider />
  </head>
  <body class="gw-v2 gw-v2-document gw-v2-catalogue">
    <a class="gw-v2-catalogue-skip" href="#gw-v2-main">Skip to content</a>
    <CatalogueHeader currentPath={currentPath} basePath={basePath} />

    <main id="gw-v2-main" class="gw-v2-catalogue-main gw-v2-page">
      <slot />
    </main>

    <footer class="gw-v2-catalogue-footer">
      <span>Greenways visual language · v2 catalogue</span>
      <a href="https://github.com/greenways-ai/visual-language">Source ↗</a>
    </footer>
  </body>
</html>
