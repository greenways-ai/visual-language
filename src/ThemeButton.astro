<button
  class="gw-theme-button"
  type="button"
  data-gw-theme-button
  title="Toggle light or dark. Shift-click to follow the system theme."
>
  <span class="gw-theme-button__label">Toggle colour theme</span>
  <svg class="gw-theme-button__moon" viewBox="0 0 24 24" aria-hidden="true">
    <path d="M20 15.2A8.4 8.4 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z" />
  </svg>
  <svg class="gw-theme-button__sun" viewBox="0 0 24 24" aria-hidden="true">
    <circle cx="12" cy="12" r="4" />
    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
  </svg>
</button>

<script>
  const root = document.documentElement;

  const applyFallback = (preference: "auto" | "light" | "dark") => {
    const dark = preference === "auto"
      ? window.matchMedia("(prefers-color-scheme: dark)").matches
      : preference === "dark";
    root.dataset.theme = dark ? "dark" : "light";
    root.dataset.themePreference = preference;
    root.style.colorScheme = dark ? "dark" : "light";
    try { localStorage.setItem("gw-theme", preference); } catch {}
    window.dispatchEvent(new CustomEvent("gw-theme-change", { detail: { preference, theme: root.dataset.theme } }));
  };

  const initialiseThemeButton = (button: HTMLButtonElement) => {
    if (button.dataset.initialised === "true") return;
    button.dataset.initialised = "true";

    const render = () => {
      const dark = root.dataset.theme === "dark";
      button.setAttribute("aria-label", dark ? "Switch to light theme" : "Switch to dark theme");
      button.setAttribute("aria-pressed", dark ? "true" : "false");
    };

    button.addEventListener("click", (event) => {
      const current = root.dataset.theme === "dark" ? "dark" : "light";
      const next = event.shiftKey ? "auto" : current === "dark" ? "light" : "dark";
      const theme = (window as any).GreenwaysTheme;
      if (theme?.apply) theme.apply(next, true);
      else applyFallback(next);
      render();
    });

    window.addEventListener("gw-theme-change", render);
    render();
  };

  document.querySelectorAll<HTMLButtonElement>("[data-gw-theme-button]").forEach(initialiseThemeButton);
</script>

<style>
  .gw-theme-button {
    width: 48px;
    height: 48px;
    display: inline-grid;
    place-items: center;
    padding: 0;
    color: var(--gw-control-text);
    background: var(--gw-control-bg);
    border: 1px solid var(--gw-line-strong);
    border-radius: 10px;
    cursor: pointer;
  }
  .gw-theme-button:hover { background: var(--gw-control-hover); }
  .gw-theme-button:focus-visible {
    outline: 3px solid var(--gw-focus);
    outline-offset: 3px;
  }
  .gw-theme-button svg {
    width: 20px;
    height: 20px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .gw-theme-button__moon { display: block; fill: currentColor !important; stroke: none !important; }
  .gw-theme-button__sun { display: none; }
  :global(:root[data-theme="dark"]) .gw-theme-button__moon { display: none; }
  :global(:root[data-theme="dark"]) .gw-theme-button__sun { display: block; }
  .gw-theme-button__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }
  @media (max-width: 560px) {
    .gw-theme-button { width: 44px; height: 44px; }
  }
</style>
