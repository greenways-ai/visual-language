---
interface Props {
  label?: string;
  class?: string;
}

const { label = "Greenways flame", class: className = "" } = Astro.props;
---

<svg
  class:list={["gw-flame", className]}
  viewBox="0 0 64 64"
  role="img"
  aria-label={label}
  focusable="false"
>
  <defs>
    <linearGradient id="gw-flame-spectrum" x1="12" y1="53" x2="50" y2="9" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--gw-v2-brand-emerald)" />
      <stop offset="0.42" stop-color="var(--gw-v2-brand-aqua)" />
      <stop offset="0.76" stop-color="var(--gw-v2-brand-sapphire)" />
      <stop offset="1" stop-color="var(--gw-v2-brand-violet)" />
    </linearGradient>
    <linearGradient id="gw-flame-core" x1="30" y1="51" x2="38" y2="22" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--gw-v2-brand-emerald)" />
      <stop offset="1" stop-color="var(--gw-v2-brand-aqua)" />
    </linearGradient>
  </defs>
  <path
    fill="url(#gw-flame-spectrum)"
    d="M35.8 4.8c.6 8.2-1.6 13.2-6.1 17.6-1.7-5.2-5.4-8.8-8.8-11.8.5 7.7-1.3 12.6-5.4 17.5-3.3 3.9-5.6 7.6-5.6 12.5C9.9 51.4 19.1 59 31.8 59c12.4 0 22.4-7 22.4-19.6 0-8.5-4.7-15.1-12-20.8.4 6.2-1.7 10.3-5.3 13.4.8-9.4-1-17.7-1.1-27.2Z"
  />
  <path
    fill="url(#gw-flame-core)"
    d="M32.3 27.7c.1 5.1-1.2 8.1-4.1 11.7-2.2 2.7-3.6 5.1-3.6 8.1 0 5.5 3.8 8.6 8.8 8.6 5.2 0 9.1-3.7 9.1-9.2 0-4.1-2.2-7.5-5.9-10.9.2 3.2-1 5.4-2.6 6.8.6-5.7-.2-10.2-1.7-15.1Z"
    opacity="0.9"
  />
</svg>

<style>
  .gw-flame { display: block; inline-size: 100%; block-size: 100%; overflow: visible; }
  .gw-flame path { transform-origin: 50% 82%; }
</style>
