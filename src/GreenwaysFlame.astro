---
interface Props {
  label?: string;
  class?: string;
}

const { label = "Greenways flame", class: className = "" } = Astro.props;
---

<svg
  class:list={["gw-flame", className]}
  viewBox="0 0 64 64"
  role="img"
  aria-label={label}
  focusable="false"
>
  <defs>
    <linearGradient id="gw-flame-spectrum" x1="12" y1="56" x2="50" y2="8" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--gw-v2-brand-emerald)" />
      <stop offset="0.34" stop-color="var(--gw-v2-brand-aqua)" />
      <stop offset="0.66" stop-color="var(--gw-v2-brand-sapphire)" />
      <stop offset="0.88" stop-color="var(--gw-v2-brand-violet)" />
      <stop offset="1" stop-color="var(--gw-v2-brand-aqua)" />
    </linearGradient>
    <linearGradient id="gw-flame-outline" x1="15" y1="55" x2="44" y2="7" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--gw-v2-brand-emerald)" />
      <stop offset="0.5" stop-color="var(--gw-v2-brand-aqua)" />
      <stop offset="1" stop-color="var(--gw-v2-brand-sapphire)" />
    </linearGradient>
    <radialGradient id="gw-flame-core" cx="50%" cy="62%" r="68%">
      <stop offset="0" stop-color="var(--gw-v2-brand-emerald)" />
      <stop offset="0.58" stop-color="var(--gw-v2-brand-aqua)" />
      <stop offset="1" stop-color="var(--gw-v2-brand-sapphire)" />
    </radialGradient>
    <linearGradient id="gw-flame-highlight" x1="25" y1="48" x2="39" y2="23" gradientUnits="userSpaceOnUse">
      <stop offset="0" stop-color="var(--gw-v2-brand-aqua)" stop-opacity="0.2" />
      <stop offset="1" stop-color="var(--gw-v2-brand-violet)" stop-opacity="0.72" />
    </linearGradient>
  </defs>
  <path
    fill="url(#gw-flame-spectrum)"
    stroke="url(#gw-flame-outline)"
    stroke-width="1.65"
    stroke-linejoin="round"
    d="M31.8 59C19.4 59 10.8 51.5 11.4 41c.4-7.2 4.3-11.6 9.1-17 4.3-4.8 4.9-10.9 3.1-18 7.6 4.1 12.5 10.8 12.4 19.1 0 2.9-.6 5.4-1.7 7.7 4.6-2.6 7.5-6.9 7.9-13 5.9 5.4 10.3 12.7 10.3 21.1C52.5 51.6 44.1 59 31.8 59Z"
  />
  <path
    fill="url(#gw-flame-core)"
    stroke="url(#gw-flame-highlight)"
    stroke-width="1.05"
    stroke-linejoin="round"
    d="M31.9 53.3c-7.5 0-12.4-4.2-12.1-10 .2-4.2 2.9-7.3 5.9-10.9 2.6-3.1 3.2-6.5 2.6-10.6 4.6 3.6 6.7 8.1 6.4 13.4-.1 2.2-.6 4.1-1.3 5.6 2.7-1.5 4.3-3.8 4.6-6.8 3.7 3.4 5.9 7.3 5.9 10.9 0 5.5-3.9 8.4-12 8.4Z"
    opacity="0.96"
  />
</svg>

<style>
  .gw-flame { display: block; inline-size: 100%; block-size: 100%; overflow: visible; }
  .gw-flame path { transform-origin: 50% 82%; vector-effect: non-scaling-stroke; }
</style>
