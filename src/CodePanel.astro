---
import { Code } from "astro:components";

interface Props {
  code: string;
  lang?: string;
  title?: string;
  meta?: string;
  caption?: string;
  compact?: boolean;
  class?: string;
}

const {
  code,
  lang = "text",
  title,
  meta,
  caption,
  compact = false,
  class: className,
} = Astro.props;
const source = code.replace(/^\n|\n$/g, "");
---

<figure class:list={["gw-code-panel", "not-content", compact && "gw-code-panel--compact", className]}>
  {(title || meta) && (
    <header>
      {title && <span>{title}</span>}
      {meta && <em>{meta}</em>}
    </header>
  )}
  <Code code={source} lang={lang as any} theme="github-dark" />
  {caption && <figcaption>{caption}</figcaption>}
</figure>

<style>
  .gw-code-panel {
    min-width: 0;
    margin: 0;
    overflow: hidden;
    background: #07131a;
    border: 1px solid color-mix(in srgb, var(--gw-accent-2) 24%, var(--gw-line));
    border-radius: 12px;
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .035);
  }

  .gw-code-panel > header {
    min-height: 40px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 0 14px;
    color: #b9dce3;
    background: rgba(13, 34, 43, .9);
    border-bottom: 1px solid rgba(117, 211, 228, .14);
    font: 600 .64rem ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    letter-spacing: .06em;
  }

  .gw-code-panel > header em {
    color: #6f98a3;
    font-style: normal;
    text-transform: uppercase;
  }

  .gw-code-panel :global(.astro-code) {
    max-width: 100%;
    margin: 0;
    padding: 18px;
    overflow: auto;
    border: 0;
    border-radius: 0;
    font: 400 .78rem/1.72 ui-monospace, SFMono-Regular, Menlo, Monaco, Consolas, monospace;
    tab-size: 2;
  }

  /* Documentation frameworks often decorate inline code. A highlighted panel is
     a self-contained surface, so none of those borders or underlines may leak
     into its code element, line wrappers, or individual syntax tokens. */
  .gw-code-panel :global(code),
  .gw-code-panel :global(.line),
  .gw-code-panel :global(.line span) {
    border: 0 !important;
    box-shadow: none !important;
    outline: 0 !important;
    text-decoration: none !important;
    background-image: none !important;
  }

  .gw-code-panel--compact :global(.astro-code) {
    padding: 14px;
    font-size: .7rem;
    line-height: 1.6;
  }

  .gw-code-panel figcaption {
    margin: 0;
    padding: 10px 14px;
    color: var(--gw-text-muted);
    background: color-mix(in srgb, var(--gw-surface) 86%, transparent);
    border-top: 1px solid var(--gw-line);
    font-size: .76rem;
  }
</style>
