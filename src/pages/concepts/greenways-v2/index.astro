---
import {
  greenwaysOsAbstractionOwners,
  greenwaysOsExecutionEnvironments,
  greenwaysOsProductSurfaces,
  greenwaysOsV2Surfaces,
} from "../../../greenways-os-v2-surfaces";
import GreenwaysOsV2Shell from "../../../site/layouts/GreenwaysOsV2Shell.astro";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const rootHref = `${base}concepts/greenways-v2/`;
const surfaceHref = (id: string) => `${rootHref}${id}/`;
---

<GreenwaysOsV2Shell
  title="Greenways OS V2 interface atlas"
  description="A complete Greenways OS interface system spanning a native desktop, full-page Chrome workspace, persistent side panel, compact popup and public web surface."
>
  <article class="gw2-overview" data-gw2-system-map data-gw2-architecture>
    <section class="gw2-overview-hero" aria-labelledby="greenways-v2-title">
      <div class="gw2-overview-hero__copy">
        <p>Personal files · work · publication</p>
        <h1 id="greenways-v2-title">A personal file<br />and work environment.</h1>
        <p>
          Greenways OS keeps selected files available across devices, helps sort them with AI, preserves the history
          around them, coordinates bounded work with people and agents, and publishes selected results.
        </p>
        <div class="gw2-overview-hero__actions">
          <a href="#gw2-product-surfaces">View the product surfaces</a>
          <a href="#gw2-architecture">View the architecture</a>
          <button type="button" data-gw2-command-open>Open a command</button>
        </div>
      </div>

      <div class="gw2-system-orbit" aria-label="Greenways OS V2 surface and provider map">
        <div class="gw2-system-core">
          <div>
            <span class="gw2-mark" aria-hidden="true"><i></i><i></i><i></i><i></i><i></i></span>
            <strong>Greenways OS</strong>
            <small>composed · bounded</small>
          </div>
        </div>
        <a class="gw2-orbit-node gw2-orbit-node--desktop" href={surfaceHref("desktop")}>
          <strong>Native desktop</strong><small>files · jobs · protected keys</small>
        </a>
        <a class="gw2-orbit-node gw2-orbit-node--extension" href={surfaceHref("extension-desktop")}>
          <strong>Extension desktop</strong><small>full-page browser workspace</small>
        </a>
        <a class="gw2-orbit-node gw2-orbit-node--panel" href={surfaceHref("extension-panel")}>
          <strong>Side panel</strong><small>current-page companion</small>
        </a>
        <a class="gw2-orbit-node gw2-orbit-node--popup" href={surfaceHref("extension-popup")}>
          <strong>Popup</strong><small>launch · status · save</small>
        </a>
        <a class="gw2-orbit-node gw2-orbit-node--web" href={surfaceHref("web")}>
          <strong>Public web</strong><small>publish · discover · remote work</small>
        </a>
        <span class="gw2-orbit-provider gw2-orbit-provider--native">greenwaysd · optional native provider</span>
        <span class="gw2-orbit-provider gw2-orbit-provider--remote">Hestia · remote documents and sync</span>
        <span class="gw2-orbit-provider gw2-orbit-provider--sandbox">Hara sandbox · no ambient authority</span>
      </div>
    </section>

    <section class="gw2-overview-principle" aria-labelledby="greenways-v2-principle">
      <span>01</span>
      <h2 id="greenways-v2-principle">The system should stay<br />out of the way.</h2>
      <p>
        Files, history, context and authority should remain understandable as work moves between devices, providers
        and public releases.
      </p>
    </section>

    <section class="gw2-product-surfaces" id="gw2-product-surfaces" aria-labelledby="gw2-product-surfaces-title">
      <header>
        <div><p>Product model</p><h2 id="gw2-product-surfaces-title">Five primary surfaces.</h2></div>
        <span>System controls support the work. They do not compete with it.</span>
      </header>
      <div class="gw2-product-grid">
        {greenwaysOsProductSurfaces.map((product) => (
          <article class:list={["gw2-product-card", `gw2-product-card--${product.id}`]} id={product.id}>
            <header>
              <span>{product.code}</span>
              <small>{product.label}</small>
            </header>
            <h3>{product.label}</h3>
            <p>{product.purpose}</p>
            <dl>
              <div><dt>Abstraction</dt><dd>{product.abstraction}</dd></div>
              <div><dt>Execution</dt><dd>{product.environments.join(" · ")}</dd></div>
              <div><dt>Boundary</dt><dd>{product.systemBoundary}</dd></div>
            </dl>
            <footer>{product.states.map((state) => <span>{state}</span>)}</footer>
          </article>
        ))}
      </div>
    </section>

    <section class="gw2-surface-atlas" aria-labelledby="greenways-v2-surfaces">
      <header>
        <div><p>Execution environments</p><h2 id="greenways-v2-surfaces">The product runs in different environments.</h2></div>
        <span>These host studies show where the abstractions run. They are not additional product destinations.</span>
      </header>

      <div class="gw2-surface-grid">
        {greenwaysOsV2Surfaces.map((surface) => (
          <a class="gw2-surface-card" href={surfaceHref(surface.id)}>
            <header>
              <span>{surface.code}</span>
              <small>{surface.viewport}</small>
            </header>
            <div class="gw2-surface-card__preview" aria-hidden="true">
              {(surface.id === "desktop" || surface.id === "extension-desktop") && (
                <div class="gw2-mini-frame">
                  <aside><i></i><i></i><i></i><i></i><i></i></aside>
                  <main><header><span></span><span></span><span></span></header><div><section></section><section></section></div></main>
                </div>
              )}
              {surface.id === "extension-panel" && (
                <div class="gw2-mini-panel-preview"><main></main><aside><span></span><span></span><span></span><span></span></aside></div>
              )}
              {surface.id === "extension-popup" && (
                <div class="gw2-mini-popup-preview"><div><span></span><span></span><span></span><span></span><span></span></div></div>
              )}
              {surface.id === "web" && (
                <div class="gw2-mini-web-preview"><header></header><main><div><i></i><i></i></div><div></div></main></div>
              )}
            </div>
            <footer>
              <p>{surface.eyebrow}</p>
              <h3>{surface.label}</h3>
              <span>{surface.summary}</span>
            </footer>
          </a>
        ))}
      </div>
    </section>

    <section class="gw2-architecture" aria-labelledby="greenways-v2-architecture-title">
      <header>
        <h2 id="greenways-v2-architecture-title">Abstractions above<br />execution environments.</h2>
        <p>
          Tahto and Hestia define the feature abstractions using Hara. Hoplite, Ignatius and Hodos provide the
          environments in which those abstractions run. Greenways OS selects, authorises and composes them.
        </p>
      </header>

      <div class="gw2-architecture-stack">
        <section class="gw2-architecture-layer gw2-architecture-layer--shells">
          <header><span>03 · PRODUCT</span><strong>Greenways OS surfaces</strong></header>
          <div>
            {greenwaysOsProductSurfaces.map((product) => <article><strong>{product.label}</strong><small>{product.purpose}</small></article>)}
          </div>
        </section>

        <section class="gw2-architecture-layer gw2-architecture-layer--core">
          <header><span>02 · ABSTRACTIONS</span><strong>Tahto and Hestia on Hara</strong></header>
          <div>
            {greenwaysOsAbstractionOwners.map((owner) => <article><strong>{owner.label}</strong><small>{owner.role}</small></article>)}
            <article><strong>Hara</strong><small>Portable contracts, packages, validators and programs</small></article>
          </div>
        </section>

        <section class="gw2-architecture-layer gw2-architecture-layer--providers">
          <header><span>01 · EXECUTION</span><strong>Runtime environments</strong></header>
          <div>
            {greenwaysOsExecutionEnvironments.map((environment) => <article><strong>{environment.label}</strong><small>{environment.role}</small></article>)}
          </div>
        </section>
      </div>
    </section>
  </article>
</GreenwaysOsV2Shell>
