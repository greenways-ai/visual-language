---
import { greenwaysProductScreens } from "../../../greenways-product-screens";
import GreenwaysProductShell from "../../../site/layouts/GreenwaysProductShell.astro";

const base = import.meta.env.BASE_URL;
const screenHref = (id: string) => `${base}concepts/greenways/${id}/`;
---

<GreenwaysProductShell
  title="Greenways product screens"
  description="Seven connected product concepts for coordinating creative work, agents, publishing, distribution, packages, identity and accountable receipts."
>
  <div class="gw-overview">
    <section class="gw-overview-hero">
      <div class="gw-overview-hero__copy">
        <p class="gw-eyebrow">Greenways product direction</p>
        <h1>One calm place for work that has to travel.</h1>
        <p class="gw-overview-hero__lede">
          Greenways joins private preparation, shared work, open distribution and verifiable outcomes without turning the product into a blockchain console or an agent control panel. These seven screens form the product spine.
        </p>
        <div class="gw-button-row">
          <a class="gw-button gw-button--primary" href={screenHref("today")}>Enter the workspace <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg></a>
          <a class="gw-button" href="#screen-collection">Explore all seven screens</a>
        </div>
        <p class="gw-overview-hero__promise"><span aria-hidden="true">01</span>Designed as a connected product, not a gallery of unrelated dashboards.</p>
      </div>

      <div class="gw-overview-map" aria-label="Greenways product journey">
        <div class="gw-overview-map__line" aria-hidden="true"></div>
        <div class="gw-overview-map__items">
          {greenwaysProductScreens.map((screen, index) => (
            <a class:list={["gw-overview-map__item", `gw-screen--${screen.tone}`]} href={screenHref(screen.id)}>
              <span>{String(index + 1).padStart(2, "0")}</span>
              <span><strong>{screen.label}</strong><small>{screen.eyebrow}</small></span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section id="screen-collection" class="gw-overview-section" aria-labelledby="screen-collection-title">
      <header class="gw-section-heading">
        <div><span class="gw-meta-label">Seven connected surfaces</span><h2 id="screen-collection-title">A product spine from intent to evidence</h2></div>
        <p>Each surface has a distinct job. Navigation, language, identity and receipts remain consistent as work moves between them.</p>
      </header>

      <div class="gw-screen-card-grid">
        {greenwaysProductScreens.map((screen, index) => (
          <a class:list={["gw-screen-card", `gw-screen--${screen.tone}`]} href={screenHref(screen.id)}>
            <div class="gw-screen-card__preview" aria-hidden="true"></div>
            <div class="gw-screen-card__meta">
              <span><strong>{String(index + 1).padStart(2, "0")} · {screen.label}</strong><small>{screen.outcome}</small></span>
              <svg viewBox="0 0 20 20" aria-hidden="true"><path d="m7 4 6 6-6 6" /></svg>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="gw-overview-section" aria-labelledby="greenways-principles-title">
      <header class="gw-section-heading">
        <div><span class="gw-meta-label">Product principles</span><h2 id="greenways-principles-title">The interface makes the architecture understandable</h2></div>
        <p>The screens deliberately foreground usefulness and human agency. Technical proof remains available, but it never becomes the product’s first sentence.</p>
      </header>
      <div class="gw-principles-grid">
        <article class="gw-principle"><span>01</span><h3>Human decisions stay visible</h3><p>Agents can prepare, compare and execute within a grant. Irreversible or externally visible actions surface as explicit human decisions.</p></article>
        <article class="gw-principle"><span>02</span><h3>Receipts, not surveillance</h3><p>Meaningful boundaries create useful evidence. The product does not log every gesture or expose private work merely because it can.</p></article>
        <article class="gw-principle"><span>03</span><h3>Portable by default</h3><p>Source, attribution, rights and derivation travel with a publication so creators do not have to reconstruct context at every destination.</p></article>
        <article class="gw-principle"><span>04</span><h3>Open systems feel approachable</h3><p>Packages and namespaces show purpose, compatibility and accountable maintainers before presenting implementation detail.</p></article>
      </div>
    </section>
  </div>
</GreenwaysProductShell>
