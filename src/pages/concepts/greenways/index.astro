---
import { greenwaysProductScreens } from "../../../greenways-product-screens";
import GreenwaysProductShell from "../../../site/layouts/GreenwaysProductShell.astro";

const base = import.meta.env.BASE_URL;
const screenHref = (id: string) => `${base}concepts/greenways/${id}/`;
const v2Href = `${base}concepts/greenways-v2/`;
---

<GreenwaysProductShell
  title="Greenways OS desktop"
  description="A desktop operating environment for creative work, shared rooms, publishing, distribution, packages, identity and accountable receipts."
>
  <div class="gw-os-home" data-os-home>
    <section class="gw-os-home__welcome" aria-labelledby="greenways-os-title">
      <p class="gw-os-home__eyebrow">Workspace 01 · Personal environment · Ready</p>
      <h1 id="greenways-os-title">Greenways OS.</h1>
      <p>
        A programmable creative environment for preparing work privately, collaborating with people and agents, and publishing portable outcomes with useful receipts.
      </p>
      <div class="gw-os-home__actions">
        <a class="gw-button gw-button--primary" href={screenHref("today")}>Open Today</a>
        <a class="gw-button" href={screenHref("studio")}>Open Studio</a>
        <a class="gw-button" href={v2Href}>Explore V2 interfaces</a>
        <button class="gw-button" type="button" data-command-open>Search workspace</button>
      </div>
    </section>

    <nav class="gw-os-desktop-apps" aria-label="Greenways desktop applications">
      {greenwaysProductScreens.map((screen) => (
        <a class:list={["gw-os-desktop-app", `gw-tone--${screen.tone}`]} href={screenHref(screen.id)}>
          <span class="gw-os-app-icon" aria-hidden="true">{screen.navCode}</span>
          <strong>{screen.label}</strong>
          <small>{screen.eyebrow}</small>
        </a>
      ))}
    </nav>

    <section class="gw-os-widget gw-os-widget--now gw-tone--sage" aria-labelledby="greenways-now-title" data-os-widget-window>
      <header class="gw-os-widget__titlebar">
        <span class="gw-os-widget__title">
          <span class="gw-os-app-icon" aria-hidden="true">TD</span>
          <span><strong id="greenways-now-title">Today</strong> <small>Daily briefing</small></span>
        </span>
        <span class="gw-os-widget__meta">3 decisions · live</span>
      </header>
      <div class="gw-os-widget__body">
        <article class="gw-os-now-brief">
          <span>What needs you</span>
          <h2>Three decisions will unblock the rest of the week.</h2>
        </article>
        <div class="gw-os-decision-list">
          <a class="gw-os-decision" href={screenHref("studio")}>
            <span class="gw-os-decision__mark" aria-hidden="true">ST</span>
            <span class="gw-os-decision__copy">
              <strong>Approve “Open distribution” release candidate</strong>
              <small>Studio · requested by Mira · 9 minute review</small>
            </span>
            <span class="gw-os-decision__state">Review</span>
          </a>
          <a class="gw-os-decision" href={screenHref("keyring")}>
            <span class="gw-os-decision__mark" aria-hidden="true">KY</span>
            <span class="gw-os-decision__copy">
              <strong>Scope Atlas to campaign reporting</strong>
              <small>Keyring · proposed grant expires in 30 days</small>
            </span>
            <span class="gw-os-decision__state">Decision</span>
          </a>
          <a class="gw-os-decision" href={screenHref("campaigns")}>
            <span class="gw-os-decision__mark" aria-hidden="true">CP</span>
            <span class="gw-os-decision__copy">
              <strong>Select the short-form campaign excerpt</strong>
              <small>Campaigns · three versions prepared</small>
            </span>
            <span class="gw-os-decision__state">Choose</span>
          </a>
        </div>
      </div>
    </section>

    <section class="gw-os-widget gw-os-widget--system" aria-labelledby="greenways-system-title" data-os-widget-window>
      <header class="gw-os-widget__titlebar">
        <span class="gw-os-widget__title">
          <span class="gw-os-app-icon gw-os-app-icon--desktop" aria-hidden="true">GW</span>
          <span><strong id="greenways-system-title">System</strong> <small>Workspace health</small></span>
        </span>
        <span class="gw-os-widget__meta">All services available</span>
      </header>
      <div class="gw-os-widget__body gw-os-system-grid">
        <a class="gw-os-system-cell" href={screenHref("keyring")}><span>Identity</span><strong>4 active grants</strong><small>Healthy</small></a>
        <a class="gw-os-system-cell" href={screenHref("packages")}><span>Packages</span><strong>18 installed</strong><small>Compatible</small></a>
        <a class="gw-os-system-cell" href={screenHref("receipts")}><span>Receipts</span><strong>14 synchronised</strong><small>Verified</small></a>
      </div>
    </section>

    <p class="gw-os-home__principle">
      These seven screens form the product spine. Applications share identity, permissions, files, agents and receipts while remaining separate tools inside one environment.
    </p>
  </div>
</GreenwaysProductShell>
