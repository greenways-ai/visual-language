---
import CatalogueShell from "../../v2/CatalogueShell.astro";
import {
  catalogueHref,
  catalogueOwnershipLabels,
  catalogueStatusLabels,
  greenwaysV2Catalogue,
  greenwaysV2CatalogueHome,
} from "../../v2/catalogue-manifest.js";

const basePath = import.meta.env.BASE_URL;
const href = (path: string) => catalogueHref(path, basePath);
---

<CatalogueShell
  title={greenwaysV2CatalogueHome.label}
  description={greenwaysV2CatalogueHome.summary}
  currentPath={greenwaysV2CatalogueHome.path}
>
  <header class="gw-v2-catalogue-hero">
    <div class="gw-v2-catalogue-hero__copy">
      <p class="gw-v2-catalogue-eyebrow">Shared contracts · executable laboratories</p>
      <h1>One catalogue.<br />Clear ownership.</h1>
      <p>
        Greenways v2 keeps reusable foundations separate from application studies. Foreman is the current application
        laboratory; earlier Greenways OS screens remain available as explicitly historical explorations.
      </p>
    </div>
  </header>

  <div class="gw-v2-catalogue-groups" data-gw-v2-catalogue-home>
    {greenwaysV2Catalogue.map((group) => (
      <section class="gw-v2-catalogue-group" aria-labelledby={`gw-v2-group-${group.id}`}>
        <header>
          <p class="gw-v2-catalogue-eyebrow">{group.id}</p>
          <h2 id={`gw-v2-group-${group.id}`}>{group.label}</h2>
          <p>{group.summary}</p>
        </header>

        <div class="gw-v2-catalogue-grid">
          {group.routes.map((route) => (
            <article
              class="gw-v2-route-card"
              data-route-id={route.id}
              data-primary={route.primary === false ? "false" : "true"}
              data-ownership={route.ownership}
            >
              <p class="gw-v2-route-card__meta">
                {catalogueStatusLabels[route.status]} · {catalogueOwnershipLabels[route.ownership]}
              </p>
              <h3>{route.label}</h3>
              <p>{route.summary}</p>
              <a href={href(route.path)}>Open route →</a>

              {route.children && route.children.length > 0 && (
                <ul class="gw-v2-route-card__children">
                  {route.children.map((child) => (
                    <li data-route-id={child.id} data-primary={child.primary === false ? "false" : "true"}>
                      <a href={href(child.path)}>
                        <span>{child.label}</span>
                        <small>{catalogueStatusLabels[child.status]}</small>
                      </a>
                    </li>
                  ))}
                </ul>
              )}
            </article>
          ))}
        </div>
      </section>
    ))}
  </div>
</CatalogueShell>
