---
import MosaicLogo from "../../../../MosaicLogo.astro";
import CatalogueShell from "../../../../v2/CatalogueShell.astro";
import {
  GREENWAYS_FABRIC_HOMEPAGE_VERSION,
  greenwaysFabricHomepage as homepage,
} from "../../../../v2/greenways-platform-homepage.js";
import "../../../../v2/greenways-platform-homepage.css";

const currentPath = "/v2/applications/greenways-platform/homepage/";
---

<CatalogueShell title={homepage.meta.title} description={homepage.meta.description} currentPath={currentPath}>
  <header class="gwf-review" data-greenways-fabric-homepage={GREENWAYS_FABRIC_HOMEPAGE_VERSION}>
    <div class="gwf-review__copy">
      <p>Issue #54 · product laboratory · public website</p>
      <h1>{homepage.meta.title}</h1>
      <p>
        Greenways Fabric is now the product centre: storage under the person’s control, one durable identity,
        bounded agents, and applications that remain replaceable views on the same personal OS.
      </p>
    </div>
    <div class="gwf-review__badges" aria-label="Specimen contract">
      <span>High-fidelity static specimen</span>
      <span>Fabric-first</span>
      <span>Neutral structure</span>
      <span>Peacock identity</span>
    </div>
  </header>

  <article id="top" class="gwf-home" aria-label="Proposed Fabric-first www.greenways.ai homepage">
    <aside class="gwf-home__truth" role="note" aria-label="Prototype limitation">
      <strong>{homepage.meta.specimenLabel}</strong>
      <span>{homepage.meta.truthfulnessNote}</span>
    </aside>

    <header class="gwf-home__header">
      <a class="gwf-home__brand" href="#top" aria-label="Greenways homepage specimen">
        <MosaicLogo project="greenways" label="Greenways mosaic mark" class="gwf-home__mark" />
        <span><strong>Greenways</strong><small>Personal Fabric</small></span>
      </a>
      <nav class="gwf-home__nav" aria-label="Homepage specimen navigation">
        {homepage.navigation.items.map((item) => <a href={item.href}>{item.label}</a>)}
      </nav>
      <a class="gwf-home__enter" href={homepage.navigation.command.href}>
        {homepage.navigation.command.label}<span aria-hidden="true">↓</span>
      </a>
    </header>

    <section class="gwf-home__hero" aria-labelledby="gwf-hero-title">
      <div class="gwf-home__hero-copy">
        <p class="gwf-home__kicker"><span aria-hidden="true">00</span>{homepage.hero.kicker}</p>
        <h2 id="gwf-hero-title">{homepage.hero.headline}</h2>
        <p class="gwf-home__lede">{homepage.hero.introduction}</p>
        <div class="gwf-home__actions" aria-label="Homepage specimen actions">
          <a class="gwf-home__action gwf-home__action--primary" href={homepage.hero.primaryAction.href}>
            {homepage.hero.primaryAction.label}<span aria-hidden="true">↓</span>
          </a>
          <a class="gwf-home__action" href={homepage.hero.secondaryAction.href}>
            {homepage.hero.secondaryAction.label}<span aria-hidden="true">↘</span>
          </a>
        </div>
        <dl class="gwf-home__hero-index">
          <div><dt>Storage</dt><dd>Where you choose</dd></div>
          <div><dt>Identity</dt><dd>One durable thread</dd></div>
          <div><dt>Agents</dt><dd>Named and bounded</dd></div>
          <div><dt>Applications</dt><dd>Replaceable views</dd></div>
        </dl>
      </div>

      <figure class="gwf-core" aria-labelledby="gwf-core-title" aria-describedby="gwf-core-note">
        <figcaption>
          <span>Operating plate · 01</span>
          <strong id="gwf-core-title">{homepage.core.statement}</strong>
        </figcaption>
        <div class="gwf-core__field">
          <span class="gwf-core__axis gwf-core__axis--horizontal" aria-hidden="true"></span>
          <span class="gwf-core__axis gwf-core__axis--vertical" aria-hidden="true"></span>
          <div class="gwf-core__centre">
            <MosaicLogo project="greenways" label="Greenways Fabric mosaic identity" class="gwf-core__mark" />
            <span>{homepage.core.label}</span>
            <strong>Personal OS</strong>
          </div>
          <ol class="gwf-core__pillars" aria-label="What the Greenways Fabric keeps connected">
            {homepage.core.pillars.map((pillar) => (
              <li data-pillar={pillar.id}>
                <span>{pillar.index}</span>
                <div><strong>{pillar.label}</strong><small>{pillar.detail}</small></div>
              </li>
            ))}
          </ol>
        </div>
        <p id="gwf-core-note"><span aria-hidden="true">↳</span>{homepage.core.note}</p>
      </figure>
    </section>

    <section id="fabric" class="gwf-section gwf-fabric" aria-labelledby="gwf-fabric-title">
      <header class="gwf-section__heading">
        <p>{homepage.fabric.kicker}</p>
        <h2 id="gwf-fabric-title">{homepage.fabric.headline}</h2>
        <span>{homepage.fabric.introduction}</span>
      </header>
      <div class="gwf-capability-grid">
        {homepage.fabric.capabilities.map((capability) => (
          <article data-fabric-capability={capability.id}>
            <header><span>{capability.index}</span><h3>{capability.label}</h3></header>
            <p>{capability.statement}</p>
            <small>{capability.detail}</small>
            <i aria-hidden="true"></i>
          </article>
        ))}
      </div>
      <p class="gwf-fabric__law"><strong>The application is a view.</strong><span>The Fabric is the OS.</span></p>
    </section>

    <section id="storage" class="gwf-section gwf-storage" aria-labelledby="gwf-storage-title">
      <div class="gwf-storage__copy">
        <p class="gwf-home__kicker"><span aria-hidden="true">02</span>{homepage.storage.kicker}</p>
        <h2 id="gwf-storage-title">{homepage.storage.headline}</h2>
        <p>{homepage.storage.introduction}</p>
        <dl class="gwf-storage__principles">
          {homepage.storage.principles.map((principle, index) => (
            <div><dt>{String(index + 1).padStart(2, "0")} · {principle.label}</dt><dd>{principle.detail}</dd></div>
          ))}
        </dl>
        <p class="gwf-storage__caveat" role="note"><span aria-hidden="true">!</span>{homepage.storage.caveat}</p>
      </div>

      <figure class="gwf-storage-plate" aria-labelledby="gwf-storage-plate-title">
        <figcaption><span>Storage choice</span><strong id="gwf-storage-plate-title">One Fabric · several homes</strong></figcaption>
        <ol>
          {homepage.storage.locations.map((location) => (
            <li data-storage-location={location.id}>
              <span>{location.index}</span>
              <div><strong>{location.label}</strong><small>{location.detail}</small></div>
              <i aria-hidden="true"></i>
            </li>
          ))}
        </ol>
        <div class="gwf-storage-plate__work">
          <span>Same work</span>
          <strong>Stable identity · open format · exact history</strong>
          <small>Move deliberately. Verify the copy. Keep the old home until recovery is proven.</small>
        </div>
      </figure>
    </section>

    <section id="identity" class="gwf-section gwf-identity" aria-labelledby="gwf-identity-title">
      <header class="gwf-section__heading gwf-section__heading--split">
        <div><p>{homepage.identity.kicker}</p><h2 id="gwf-identity-title">{homepage.identity.headline}</h2></div>
        <span>{homepage.identity.introduction}</span>
      </header>

      <div class="gwf-identity__layout">
        <figure class="gwf-identity-map" aria-labelledby="gwf-identity-map-title">
          <figcaption id="gwf-identity-map-title">Identity relationship plate</figcaption>
          <div class="gwf-identity-map__centre">
            <MosaicLogo project="greenways" label="Greenways identity mark" class="gwf-identity-map__mark" />
            <strong>{homepage.identity.centre.label}</strong>
            <small>{homepage.identity.centre.detail}</small>
          </div>
          <ol aria-label="Identities and surfaces linked to the person">
            {homepage.identity.links.map((link) => (
              <li data-identity-link={link.id}>
                <span>{link.index}</span>
                <div><strong>{link.label}</strong><small>{link.detail}</small></div>
              </li>
            ))}
          </ol>
        </figure>
        <ol class="gwf-identity__laws" aria-label="Identity separation laws">
          {homepage.identity.laws.map((law, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{law}</p></li>)}
        </ol>
      </div>
    </section>

    <section id="agents" class="gwf-section gwf-agents" aria-labelledby="gwf-agents-title">
      <header class="gwf-section__heading">
        <p>{homepage.agents.kicker}</p>
        <h2 id="gwf-agents-title">{homepage.agents.headline}</h2>
        <span>{homepage.agents.introduction}</span>
      </header>
      <div class="gwf-agent-grid">
        {homepage.agents.examples.map((agent) => (
          <article data-agent-example={agent.id}>
            <header><span>{agent.index}</span><div><strong>{agent.label}</strong><small>{agent.application}</small></div></header>
            <p>{agent.purpose}</p>
            <dl>
              <div><dt>Can see</dt><dd>{agent.scope}</dd></div>
              <div><dt>Access</dt><dd>{agent.expiry}</dd></div>
              <div><dt>Returns</dt><dd>{agent.return}</dd></div>
            </dl>
            <footer><span>Named participant</span><strong>Revocable independently</strong></footer>
          </article>
        ))}
      </div>
      <p class="gwf-agents__rule">{homepage.agents.rule}</p>
    </section>

    <section id="surfaces" class="gwf-section gwf-surfaces" aria-labelledby="gwf-surfaces-title">
      <header class="gwf-section__heading gwf-section__heading--split">
        <div><p>{homepage.surfaces.kicker}</p><h2 id="gwf-surfaces-title">{homepage.surfaces.headline}</h2></div>
        <span>{homepage.surfaces.introduction}</span>
      </header>
      <div class="gwf-surface-track" aria-label="Surfaces connected to the same Greenways Fabric">
        <div class="gwf-surface-track__fabric"><MosaicLogo project="greenways" label="Shared Greenways Fabric" /><strong>Same Fabric</strong><small>Same identity · stable references</small></div>
        <ol>
          {homepage.surfaces.items.map((surface) => (
            <li data-surface={surface.id}>
              <span>{surface.index}</span>
              <div><small>{surface.verb}</small><strong>{surface.label}</strong><p>{surface.detail}</p></div>
            </li>
          ))}
        </ol>
      </div>
    </section>

    <section id="applications" class="gwf-section gwf-applications" aria-labelledby="gwf-applications-title">
      <header class="gwf-section__heading">
        <p>{homepage.applications.kicker}</p>
        <h2 id="gwf-applications-title">{homepage.applications.headline}</h2>
        <span>{homepage.applications.introduction}</span>
      </header>
      <div class="gwf-application-grid">
        {homepage.applications.items.map((application) => (
          <article data-application={application.id}>
            <header><span>{application.index}</span><small>{application.verb}</small></header>
            <h3>{application.label}</h3>
            <p>{application.detail}</p>
            <footer><span>Uses your Fabric</span><i aria-hidden="true"></i></footer>
          </article>
        ))}
      </div>
    </section>

    <section id="platform" class="gwf-section gwf-platform" aria-labelledby="gwf-platform-title">
      <header class="gwf-section__heading">
        <p>{homepage.platform.kicker}</p>
        <h2 id="gwf-platform-title">{homepage.platform.headline}</h2>
        <span>{homepage.platform.introduction}</span>
      </header>
      <div class="gwf-boundary" aria-label="Private Fabric and optional Greenways Platform boundary">
        <article class="gwf-boundary__side" data-boundary="private">
          <header><span>Private · local</span><h3>{homepage.platform.privateSide.label}</h3></header>
          <p>{homepage.platform.privateSide.detail}</p>
          <ul>{homepage.platform.privateSide.items.map((item) => <li>{item}</li>)}</ul>
        </article>
        <div class="gwf-boundary__crossing">
          <span aria-hidden="true">→</span>
          <strong>{homepage.platform.crossing.label}</strong>
          <p>{homepage.platform.crossing.detail}</p>
          <span aria-hidden="true">←</span>
        </div>
        <article class="gwf-boundary__side" data-boundary="hosted">
          <header><span>Optional · hosted</span><h3>{homepage.platform.hostedSide.label}</h3></header>
          <p>{homepage.platform.hostedSide.detail}</p>
          <ul>{homepage.platform.hostedSide.items.map((item) => <li>{item}</li>)}</ul>
        </article>
      </div>
    </section>

    <section id="open" class="gwf-section gwf-open" aria-labelledby="gwf-open-title">
      <header class="gwf-section__heading gwf-section__heading--split">
        <div><p>{homepage.openPrinciples.kicker}</p><h2 id="gwf-open-title">{homepage.openPrinciples.headline}</h2></div>
        <span>Open source and open standards matter because the person can keep operating, moving, inspecting, and rebuilding without asking one application for permission.</span>
      </header>
      <ol>
        {homepage.openPrinciples.items.map((principle) => (
          <li data-open-principle={principle.id}><span>{principle.index}</span><h3>{principle.label}</h3><p>{principle.detail}</p></li>
        ))}
      </ol>
    </section>

    <section id="start" class="gwf-home__doorway" aria-labelledby="gwf-doorway-title">
      <div class="gwf-home__doorway-mark" aria-hidden="true">
        <MosaicLogo project="greenways" label="" class="gwf-home__doorway-logo" />
      </div>
      <div>
        <p>{homepage.finalDoorway.kicker}</p>
        <h2 id="gwf-doorway-title">{homepage.finalDoorway.headline}</h2>
        <span>{homepage.finalDoorway.introduction}</span>
      </div>
      <a href={homepage.finalDoorway.action.href}>{homepage.finalDoorway.action.label}<span aria-hidden="true">↑</span></a>
      <small>{homepage.finalDoorway.secondary}</small>
    </section>

    <footer class="gwf-home__footer">
      <span>Greenways Fabric</span>
      <nav aria-label="Homepage specimen footer"><a href="#fabric">About the Fabric</a><a href="#applications">Applications</a><a href="#open">Open foundations</a></nav>
      <small>Public homepage study · not a live application</small>
    </footer>
  </article>

  <section class="gwf-adoption" aria-labelledby="gwf-adoption-title">
    <header><p>Production handoff</p><h2 id="gwf-adoption-title">What the production site must preserve.</h2></header>
    <ol>{homepage.adoptionNotes.map((note, index) => <li><span>{String(index + 1).padStart(2, "0")}</span><p>{note}</p></li>)}</ol>
    <p>
      Production navigation, installation, storage, identity, agent authority, application state, hosted connections,
      and deployment remain owned by the systems that serve <code>www.greenways.ai</code> and Greenways OS.
    </p>
  </section>
</CatalogueShell>
