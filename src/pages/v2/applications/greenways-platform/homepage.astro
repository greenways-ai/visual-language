---
import MosaicLogo from "../../../../MosaicLogo.astro";
import {
  GREENWAYS_FABRIC_HOMEPAGE_VERSION,
  greenwaysFabricHomepage as homepage,
} from "../../../../v2/greenways-platform-homepage.js";
import { visualLayoutSections } from "../../../../v2/visual-layout-manifest.js";
import "../../../../v2/greenways-platform-homepage.css";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
const visualLanguageHref = `${base}v2/`;
const visualHref = (path: string, external = false) => external ? path : `${base}${path.replace(/^\/+/, "")}`;
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
---

<!doctype html>
<html lang="en" data-theme="dark" data-greenways-fabric-homepage={GREENWAYS_FABRIC_HOMEPAGE_VERSION}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={homepage.meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={`${homepage.meta.title} · Greenways`} />
    <meta property="og:description" content={homepage.meta.description} />
    <meta property="og:url" content={canonical} />
    <title>{homepage.meta.title} · Greenways</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("greenways-fabric-home-theme");
          const preferred = window.matchMedia("(prefers-color-scheme: light)").matches ? "light" : "dark";
          document.documentElement.dataset.theme = stored || preferred;
        } catch {
          document.documentElement.dataset.theme = "dark";
        }
      })();
    </script>
  </head>

  <body
    class="gw2-body gwf-experience-body"
    data-gwf-mode="scatter"
    data-gwf-app="spaces"
    data-gwf-share="private"
  >
    <a class="gwf-skip-link" href="#greenways-fabric-main">Skip to the Fabric experience</a>

    <header class="gwf-experience-bar">
      <a class="gwf-experience-brand" href="#top" aria-label="Greenways Fabric homepage">
        <MosaicLogo project="greenways" label="Greenways mosaic mark" class="gwf-experience-brand__mark" />
        <span><strong>Greenways</strong><small>Fabric</small></span>
      </a>

      <div class="gwf-experience-status">
        <span aria-hidden="true"></span>
        <span>{homepage.meta.specimenLabel}</span>
      </div>

      <div class="gwf-experience-controls">
        <div class="gwf-mode-switch" role="group" aria-label="Decluttering view">
          {homepage.modes.map((mode) => (
            <button
              type="button"
              data-gwf-mode-select={mode.id}
              aria-pressed={mode.id === "scatter" ? "true" : "false"}
            >
              {mode.label}
            </button>
          ))}
        </div>
        <button
          class="gwf-theme-toggle"
          type="button"
          data-gwf-theme-toggle
          aria-label="Switch colour theme"
          aria-pressed="false"
        >
          <svg class="gwf-theme-sun" viewBox="0 0 20 20" aria-hidden="true">
            <circle cx="10" cy="10" r="3"></circle>
            <path d="M10 1.8v2M10 16.2v2M1.8 10h2M16.2 10h2M4.2 4.2l1.4 1.4M14.4 14.4l1.4 1.4M4.2 15.8l1.4-1.4M14.4 5.6l1.4-1.4"></path>
          </svg>
          <svg class="gwf-theme-moon" viewBox="0 0 20 20" aria-hidden="true">
            <path d="M16.6 12.8A7 7 0 0 1 7.2 3.4a7 7 0 1 0 9.4 9.4Z"></path>
          </svg>
        </button>
        <button
          class="gwf-navigator-toggle"
          type="button"
          data-gwf-navigator-open
          aria-controls="gwf-visual-navigator"
          aria-expanded="false"
          aria-label="Open visual navigator"
        >
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M3 4h14v4H3zM3 12h6v4H3zM13 12h4v4h-4z" /></svg>
          <span>Navigator</span>
        </button>
      </div>
    </header>

    <aside id="gwf-visual-navigator" class="gwf-visual-navigator" data-gwf-navigator hidden>
      <header><span>Greenways visual navigator</span><button type="button" data-gwf-navigator-close aria-label="Close visual navigator">×</button></header>
      {visualLayoutSections.map((section, index) => (
        <section>
          <a class="gwf-visual-navigator__section" href={visualHref(section.hubPath)}><span>{String(index + 1).padStart(2, "0")} · {section.label}</span><small>Open section ↗</small></a>
          {section.routes.map((route) => route.path ? <a class="gwf-visual-navigator__item" href={visualHref(route.path, route.external)}><b>{route.label}</b><small>{route.summary}</small></a> : <span class="gwf-visual-navigator__item is-placeholder"><b>{route.label}</b><small>{route.summary}</small></span>)}
        </section>
      ))}
    </aside>

    <main id="greenways-fabric-main">
      <section id="top" class="gwf-arrival" aria-labelledby="gwf-arrival-title">
        <div class="gwf-arrival__copy">
          <p>{homepage.hero.kicker}</p>
          <h1 id="gwf-arrival-title">{homepage.hero.headline}</h1>
          <span>{homepage.hero.introduction}</span>
        </div>

        <figure class="gwf-declutter-stage" aria-labelledby="gwf-declutter-title">
          <figcaption id="gwf-declutter-title" class="gwf-sr-only">
            A scattered set of tabs, files, notes, accounts, agent outputs, tasks, receipts, and sources settles into one Greenways Fabric workspace with shared storage, identity, agent scopes, Spaces, and Flow.
          </figcaption>

          <div class="gwf-stage-atmosphere" aria-hidden="true">
            <span></span><span></span><span></span>
          </div>

          <div class="gwf-fragment-field" aria-hidden="true">
            {homepage.fragments.map((fragment, index) => (
              <article
                class="gwf-fragment"
                data-gwf-fragment={fragment.id}
                style={`--gwf-fragment-order:${index}`}
              >
                <span>{fragment.glyph}</span>
                <div><strong>{fragment.label}</strong><small>{fragment.detail}</small></div>
              </article>
            ))}
          </div>

          <section class="gwf-workspace" aria-label="Greenways Fabric workspace">
            <header class="gwf-workspace__chrome">
              <div class="gwf-window-dots" aria-hidden="true"><i></i><i></i><i></i></div>
              <div class="gwf-workspace__identity">
                <MosaicLogo project="greenways" label="" class="gwf-workspace__mark" />
                <span><strong>{homepage.fabric.label}</strong><small>home · private</small></span>
              </div>
              <dl class="gwf-workspace__health">
                {homepage.fabric.status.map((item) => (
                  <div data-gwf-dock={item.id}><dt>{item.label}</dt><dd>{item.value}</dd></div>
                ))}
              </dl>
            </header>

            <div class="gwf-workspace__body">
              <nav class="gwf-workspace__dock" aria-label="Current applications">
                {homepage.applications.items.map((application) => (
                  <button
                    type="button"
                    data-gwf-app-select={application.id}
                    aria-pressed={application.id === "spaces" ? "true" : "false"}
                    aria-label={`Open ${application.label} specimen`}
                  >
                    <span aria-hidden="true">{application.id === "spaces" ? "S" : "F"}</span>
                    <small>{application.label}</small>
                  </button>
                ))}
              </nav>

              <aside class="gwf-object-rail" aria-label="Fabric objects">
                <header><span>Fabric</span><button type="button" disabled aria-label="Add object is not connected in this specimen">+</button></header>
                <ol>
                  {homepage.workspace.objects.map((object) => (
                    <li data-object={object.id} data-state={object.state} data-gwf-dock={object.id === "brief" ? "notes" : object.id === "release" ? "tasks" : "source"}>
                      <span aria-hidden="true"></span>
                      <div><strong>{object.label}</strong><small>{object.kind}</small></div>
                    </li>
                  ))}
                </ol>
                <footer><span aria-hidden="true">⌁</span><small>All references remain linked</small></footer>
              </aside>

              <section class="gwf-workspace__canvas">
                <header class="gwf-canvas-bar">
                  <div class="gwf-app-tabs" role="tablist" aria-label="Fabric application views">
                    {homepage.applications.items.map((application) => (
                      <button
                        type="button"
                        role="tab"
                        data-gwf-app-select={application.id}
                        aria-selected={application.id === "spaces" ? "true" : "false"}
                        aria-controls={`gwf-${application.id}-panel`}
                      >
                        <span>{application.label}</span><small>{application.verb}</small>
                      </button>
                    ))}
                  </div>
                  <button class="gwf-canvas-command" type="button" data-gwf-mode-select="fabric">
                    <span aria-hidden="true">⌘</span><span>Settle</span>
                  </button>
                </header>

                <div id="gwf-spaces-panel" class="gwf-app-panel gwf-spaces-view" role="tabpanel" data-gwf-app-panel="spaces">
                  <div class="gwf-spaces-map" aria-label="Spaces relationship map">
                    <span class="gwf-map-thread gwf-map-thread--a" aria-hidden="true"></span>
                    <span class="gwf-map-thread gwf-map-thread--b" aria-hidden="true"></span>
                    <span class="gwf-map-thread gwf-map-thread--c" aria-hidden="true"></span>
                    <article class="gwf-focus-card">
                      <span>Selected Space</span>
                      <MosaicLogo project="greenways" label="" class="gwf-focus-card__mark" />
                      <h2>{homepage.workspace.spaces.title}</h2>
                      <small>{homepage.workspace.spaces.meta}</small>
                    </article>
                    {homepage.workspace.spaces.sources.map((source, index) => (
                      <article class="gwf-source-node" data-source-node={source.id} style={`--gwf-source-order:${index}`}>
                        <span aria-hidden="true"></span>
                        <div><strong>{source.label}</strong><small>{source.state}</small></div>
                      </article>
                    ))}
                  </div>
                  <aside class="gwf-spaces-document">
                    <header><span>Cited brief</span><small>current</small></header>
                    <div class="gwf-document-lines" aria-hidden="true">
                      <i></i><i></i><i></i><i></i><i></i><i></i>
                    </div>
                    <footer><span>12 references</span><span>3 agent notes</span></footer>
                  </aside>
                </div>

                <div id="gwf-flow-panel" class="gwf-app-panel gwf-flow-view" role="tabpanel" data-gwf-app-panel="flow" hidden>
                  <header>
                    <div><span>{homepage.workspace.flow.verb}</span><h2>{homepage.workspace.flow.title}</h2></div>
                    <small>{homepage.workspace.flow.meta}</small>
                  </header>
                  <ol class="gwf-flow-lanes">
                    {homepage.workspace.flow.lanes.map((lane) => (
                      <li data-flow-lane={lane.id}>
                        <header><span>{lane.label}</span><small>{lane.count}</small></header>
                        <article><i aria-hidden="true"></i><strong>{lane.item}</strong><small>linked to Fabric history</small></article>
                      </li>
                    ))}
                  </ol>
                  <footer><span>1 approval</span><span>3 attributable returns</span><span>0 hidden effects</span></footer>
                </div>
              </section>

              <aside class="gwf-inspector" aria-label="Identity and agent scopes">
                <section class="gwf-identity-card" data-gwf-dock="identity">
                  <header><span>Identity</span><i aria-hidden="true"></i></header>
                  <div>
                    <MosaicLogo project="greenways" label="" class="gwf-identity-card__mark" />
                    <span><strong>{homepage.identity.label}</strong><small>{homepage.identity.detail}</small></span>
                  </div>
                  <footer><span>Desktop</span><span>Browser</span></footer>
                </section>

                <section class="gwf-agent-stack" data-gwf-dock="agent">
                  <header><span>Agents</span><small>bounded</small></header>
                  {homepage.agents.map((agent) => (
                    <article data-agent={agent.id}>
                      <div><i aria-hidden="true"></i><span><strong>{agent.label}</strong><small>{agent.application}</small></span></div>
                      <dl><dt>Scope</dt><dd>{agent.scope}</dd><dt>Access</dt><dd>{agent.state}</dd></dl>
                    </article>
                  ))}
                </section>
              </aside>
            </div>

            <footer class="gwf-workspace__status" data-gwf-dock="receipt">
              <span>home-server-01</span>
              <span>identity linked</span>
              <span>agent scopes current</span>
              <span>history retained</span>
            </footer>
          </section>
        </figure>

        <footer class="gwf-arrival__status">
          <dl>
            {homepage.fabric.status.map((item) => (
              <div><dt>{item.label}</dt><dd>{item.value}</dd></div>
            ))}
          </dl>
          <button type="button" data-gwf-replay>
            <span aria-hidden="true">↻</span><span>Replay declutter</span>
          </button>
        </footer>
      </section>

      <section id="applications" class="gwf-views" aria-labelledby="gwf-views-title">
        <header>
          <p>Current application views</p>
          <h2 id="gwf-views-title">{homepage.applications.headline}</h2>
        </header>
        <div class="gwf-view-ribbon" aria-hidden="true">
          <div><span>S</span><strong>Spaces</strong><small>sources · maps · briefs</small></div>
          <i></i>
          <div><span class="gwf-view-ribbon__fabric"><MosaicLogo project="greenways" label="" /></span><strong>Fabric</strong><small>identity · storage · history</small></div>
          <i></i>
          <div><span>F</span><strong>Flow</strong><small>people · agents · outcomes</small></div>
        </div>
      </section>

      <section id="platform" class="gwf-boundary-scene" aria-labelledby="gwf-boundary-title">
        <header>
          <p>Optional Platform</p>
          <h2 id="gwf-boundary-title">{homepage.platform.headline}</h2>
        </header>

        <div class="gwf-boundary-plane">
          <section class="gwf-private-plane" aria-label="Private Fabric">
            <header><span>Private Fabric</span><small>default</small></header>
            <div class="gwf-private-stack">
              {homepage.platform.privateItems.map((item, index) => (
                <article style={`--gwf-private-order:${index}`}><i aria-hidden="true"></i><strong>{item}</strong></article>
              ))}
            </div>
          </section>

          <div class="gwf-crossing" aria-hidden="true">
            <span></span><span></span><span></span>
            <article class="gwf-selected-projection">
              <i></i><strong>{homepage.platform.selected.label}</strong><small>{homepage.platform.selected.detail}</small>
            </article>
          </div>

          <section class="gwf-platform-plane" aria-label="Optional Greenways Platform">
            <header><span>Greenways Platform</span><small>optional</small></header>
            <div>
              {homepage.platform.hostedItems.map((item) => <span>{item}</span>)}
            </div>
          </section>
        </div>

        <footer>
          <button type="button" data-gwf-share-toggle aria-pressed="false">
            <span data-gwf-share-label>Share selected piece</span><span aria-hidden="true">→</span>
          </button>
          <small>Nothing else moves.</small>
        </footer>
      </section>

      <section id="start" class="gwf-closing" aria-labelledby="gwf-closing-title">
        <MosaicLogo project="greenways" label="Greenways Fabric" class="gwf-closing__mark" />
        <div><h2 id="gwf-closing-title">{homepage.closing.headline}</h2><p>{homepage.closing.detail}</p></div>
        <nav aria-label="Homepage specimen closing links">
          <button type="button" data-gwf-replay>Replay</button>
          <a href={visualLanguageHref}>Visual Language</a>
        </nav>
        <small>{homepage.meta.truthfulnessNote}</small>
      </section>
    </main>

    <script is:inline>
      (() => {
        const body = document.body;
        const root = document.documentElement;
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        const modeButtons = [...document.querySelectorAll("[data-gwf-mode-select]")];
        const appButtons = [...document.querySelectorAll("[data-gwf-app-select]")];
        const appPanels = [...document.querySelectorAll("[data-gwf-app-panel]")];
        const shareToggle = document.querySelector("[data-gwf-share-toggle]");
        const shareLabel = document.querySelector("[data-gwf-share-label]");
        const navigator = document.querySelector("[data-gwf-navigator]");
        const navigatorOpen = document.querySelector("[data-gwf-navigator-open]");
        const navigatorClose = document.querySelector("[data-gwf-navigator-close]");

        const setNavigator = (open) => {
          if (!navigator) return;
          navigator.hidden = !open;
          navigatorOpen?.setAttribute("aria-expanded", String(open));
          document.body.dataset.gwfNavigator = String(open);
        };

        navigatorOpen?.addEventListener("click", () => setNavigator(navigator?.hidden !== false));
        navigatorClose?.addEventListener("click", () => setNavigator(false));
        document.addEventListener("keydown", (event) => {
          if (event.key === "Escape") setNavigator(false);
        });

        const setMode = (mode) => {
          body.dataset.gwfMode = mode;
          modeButtons.forEach((button) => {
            button.setAttribute("aria-pressed", String(button.getAttribute("data-gwf-mode-select") === mode));
          });
        };

        const settle = () => {
          setMode("scatter");
          window.setTimeout(() => setMode("fabric"), reducedMotion.matches ? 0 : 720);
        };

        const setApp = (app) => {
          body.dataset.gwfApp = app;
          appButtons.forEach((button) => {
            const active = button.getAttribute("data-gwf-app-select") === app;
            if (button.getAttribute("role") === "tab") button.setAttribute("aria-selected", String(active));
            else button.setAttribute("aria-pressed", String(active));
          });
          appPanels.forEach((panel) => {
            panel.hidden = panel.getAttribute("data-gwf-app-panel") !== app;
          });
        };

        modeButtons.forEach((button) => {
          button.addEventListener("click", () => setMode(button.getAttribute("data-gwf-mode-select") || "fabric"));
        });

        document.querySelectorAll("[data-gwf-replay]").forEach((button) => {
          button.addEventListener("click", settle);
        });

        appButtons.forEach((button) => {
          button.addEventListener("click", () => setApp(button.getAttribute("data-gwf-app-select") || "spaces"));
        });

        shareToggle?.addEventListener("click", () => {
          const selected = body.dataset.gwfShare === "selected";
          body.dataset.gwfShare = selected ? "private" : "selected";
          shareToggle.setAttribute("aria-pressed", String(!selected));
          if (shareLabel) shareLabel.textContent = selected ? "Share selected piece" : "Return it private";
        });

        const themeToggle = document.querySelector("[data-gwf-theme-toggle]");
        themeToggle?.setAttribute("aria-pressed", String(root.dataset.theme === "light"));
        themeToggle?.addEventListener("click", (event) => {
          const button = event.currentTarget;
          const next = root.dataset.theme === "dark" ? "light" : "dark";
          root.dataset.theme = next;
          button?.setAttribute("aria-pressed", String(next === "light"));
          try { localStorage.setItem("greenways-fabric-home-theme", next); } catch {}
        });

        if (reducedMotion.matches) setMode("fabric");
        else requestAnimationFrame(() => window.setTimeout(() => setMode("fabric"), 520));
      })();
    </script>
  </body>
</html>
