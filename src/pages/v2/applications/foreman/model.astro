---
import {
  FOREMAN_MODEL_VERSION,
  foremanCoreJourney,
  foremanDetailLayers,
  foremanEntityDefinitions,
  foremanExperienceStates,
  foremanPrimaryNavigation,
  foremanRelationships,
  foremanRouteInventory,
  foremanTruthfulnessRules,
} from "../../../../foreman/product-model.js";
import "../../../../v2/document.css";

type NavigationItem = {
  id: string;
  label: string;
  route: string;
  purpose: string;
};

type JourneyItem = {
  step: number;
  label: string;
  route: string;
  outcome: string;
};

type EntityDefinition = {
  id: string;
  label: string;
  owner: string;
  visibility: string;
  purpose: string;
  parents: readonly string[];
  lifecycle: readonly string[];
  normalFields: readonly string[];
};

type ExperienceState = {
  id: string;
  label: string;
  meaning: string;
  evidence: string;
};

type TruthfulnessRule = {
  id: string;
  statement: string;
};

type Relationship = {
  from: string;
  to: string;
  cardinality: string;
  rule: string;
};

type DetailLayer = {
  id: string;
  label: string;
  purpose: string;
  includes: readonly string[];
};

type RouteItem = {
  id: string;
  pattern: string;
  label: string;
  states: readonly string[];
};

type SurfaceGroup = {
  id: string;
  label: string;
  routes: readonly RouteItem[];
};

const navigation = foremanPrimaryNavigation as readonly NavigationItem[];
const journey = foremanCoreJourney as readonly JourneyItem[];
const entities = foremanEntityDefinitions as readonly EntityDefinition[];
const experienceStates = foremanExperienceStates as readonly ExperienceState[];
const truthfulnessRules = foremanTruthfulnessRules as readonly TruthfulnessRule[];
const relationships = foremanRelationships as readonly Relationship[];
const detailLayers = foremanDetailLayers as readonly DetailLayer[];

const surfaceGroups: readonly SurfaceGroup[] = [
  {
    id: "desktop",
    label: "Desktop and browser workspace",
    routes: foremanRouteInventory.desktop as readonly RouteItem[],
  },
  {
    id: "browser-companion",
    label: "Browser companion",
    routes: foremanRouteInventory.browserCompanion as readonly RouteItem[],
  },
  {
    id: "cli",
    label: "CLI companion",
    routes: foremanRouteInventory.cli as readonly RouteItem[],
  },
];
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Executable low-fidelity Foreman product language, entity, route and state contract." />
    <title>Foreman product model · Greenways visual language</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("greenways-v2-theme");
          document.documentElement.dataset.theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch { document.documentElement.dataset.theme = "light"; }
      })();
    </script>
  </head>
  <body class="gw-v2 gw-v2-document fm" data-foreman-model-version={FOREMAN_MODEL_VERSION}>
    <a class="fm__skip" href="#foreman-model-main">Skip to product model</a>
    <header class="fm__bar">
      <div class="fm__identity"><span class="fm__mark" aria-hidden="true"><i></i><i></i><i></i><i></i></span><div><strong>Foreman</strong><small>Product model · low-fidelity contract</small></div></div>
      <button type="button" data-theme-toggle aria-label="Switch to dark theme">Theme</button>
    </header>

    <div class="fm__frame">
      <nav class="fm__nav" aria-label="Proposed Foreman primary navigation" data-foreman-primary-navigation>
        <p>Primary navigation</p>
        {navigation.map((item, index) => (
          <div class:list={["fm__nav-item", { "is-active": index === 1 }]}><span>{String(index + 1).padStart(2, "0")}</span><div><strong>{item.label}</strong><small>{item.purpose}</small></div></div>
        ))}
        <p class="fm__note">Infrastructure belongs in Settings → Diagnostics, not ordinary navigation.</p>
      </nav>

      <main id="foreman-model-main" class="fm__main" tabindex="-1">
        <section class="fm__hero"><p>Issue #35 · specimen data only</p><h1>Choose the project.<br />Understand the work.<br />See the evidence.</h1><p>One buildout may span several providers and interfaces. Foreman keeps every person, agent, connection, and live session distinct while presenting one coherent project outcome.</p></section>

        <section class="fm__section" data-foreman-core-journey>
          <header><p>01 · Core journey</p><h2>Five steps, one evidence trail.</h2></header>
          <ol class="fm__journey">{journey.map((item) => <li><span>{item.step}</span><div><strong>{item.label}</strong><code>{item.route}</code><small>{item.outcome}</small></div></li>)}</ol>
        </section>

        <section class="fm__section" data-foreman-entities>
          <header><p>02 · Domain</p><h2>Entities do not blur together.</h2></header>
          <div class="fm__grid">{entities.map((entity) => (
            <article data-foreman-entity={entity.id}><header><span>{entity.visibility}</span><strong>{entity.label}</strong></header><p>{entity.purpose}</p><dl><div><dt>Owner</dt><dd>{entity.owner}</dd></div><div><dt>Parents</dt><dd>{entity.parents.join(", ") || "None"}</dd></div></dl><details><summary>Required fields and states</summary><p><b>Normal:</b> {entity.normalFields.join(" · ")}</p><p><b>States:</b> {entity.lifecycle.join(" · ")}</p></details></article>
          ))}</div>
        </section>

        <section class="fm__section" data-foreman-experience-states>
          <header><p>03 · Required states</p><h2>The difficult states are part of the product.</h2></header>
          <div class="fm__states">{experienceStates.map((state) => <article data-state={state.id}><strong>{state.label}</strong><p>{state.meaning}</p><small>{state.evidence}</small></article>)}</div>
        </section>

        <section class="fm__section" data-foreman-truthfulness>
          <header><p>04 · Truthfulness</p><h2>A request is not a result.</h2></header>
          <ol class="fm__truth">{truthfulnessRules.map((rule) => <li data-rule={rule.id}>{rule.statement}</li>)}</ol>
        </section>

        <section class="fm__section" data-foreman-relationships>
          <header><p>05 · Relationships</p><h2>One buildout, many attributable contexts.</h2></header>
          <div class="fm__relations">{relationships.map((relation) => <article><code>{relation.from}</code><span>{relation.cardinality}</span><code>{relation.to}</code><p>{relation.rule}</p></article>)}</div>
        </section>

        <section class="fm__section" data-foreman-detail-layers>
          <header><p>06 · Disclosure</p><h2>Technical detail stays available, not dominant.</h2></header>
          <div class="fm__layers">{detailLayers.map((layer) => <article><strong>{layer.label}</strong><p>{layer.purpose}</p><small>{layer.includes.join(" · ")}</small></article>)}</div>
        </section>

        <section class="fm__section" data-foreman-surface-inventory>
          <header><p>07 · Delivery surfaces</p><h2>Shared objects, purpose-built views.</h2></header>
          <div class="fm__surfaces">{surfaceGroups.map((group) => <article data-surface={group.id}><h3>{group.label}</h3><ul>{group.routes.map((route) => <li><strong>{route.label}</strong><code>{route.pattern}</code><small>{route.states.join(" · ")}</small></li>)}</ul></article>)}</div>
        </section>
      </main>
    </div>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector("[data-theme-toggle]");
        const sync = () => button?.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
        button?.addEventListener("click", () => { root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark"; try { localStorage.setItem("greenways-v2-theme", root.dataset.theme); } catch {} sync(); });
        sync();
      })();
    </script>
  </body>
</html>

<style is:global>
  .fm { min-height: 100%; margin: 0; background: var(--gw-v2-canvas); }
  .fm__skip { position: fixed; z-index: 100; inset: .5rem auto auto .5rem; transform: translateY(-180%); padding: .6rem; background: var(--gw-v2-surface-raised); border: 1px solid var(--gw-v2-seam-strong); }.fm__skip:focus{transform:none}
  .fm__bar { position: sticky; z-index: 20; top: 0; min-height: 3.75rem; display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: .65rem clamp(1rem,3vw,2rem); background: var(--gw-v2-surface-overlay); border-bottom: 1px solid var(--gw-v2-seam); backdrop-filter: blur(16px); }
  .fm__identity{display:flex;align-items:center;gap:.75rem}.fm__identity div{display:grid}.fm__identity small,.fm__bar button,.fm__section>header>p,.fm__hero>p:first-child,.fm__nav>p{color:var(--gw-v2-text-muted);font:600 var(--gw-v2-type-xs) var(--gw-v2-font-code);letter-spacing:.08em;text-transform:uppercase}
  .fm__mark{width:2rem;height:2rem;display:grid;grid-template-columns:repeat(2,1fr);gap:2px;padding:3px;background:var(--gw-v2-surface-raised);border:1px solid var(--gw-v2-seam-strong)}.fm__mark i:nth-child(1){background:var(--gw-v2-brand-emerald,var(--gw-verdigris))}.fm__mark i:nth-child(2){background:var(--gw-v2-brand-aqua,var(--gw-focus))}.fm__mark i:nth-child(3){background:var(--gw-v2-brand-sapphire,var(--gw-focus))}.fm__mark i:nth-child(4){background:var(--gw-v2-brand-violet,var(--gw-terracotta))}
  .fm__bar button{min-height:2.35rem;padding:.4rem .75rem;color:var(--gw-v2-text);background:var(--gw-v2-surface);border:1px solid var(--gw-v2-seam-strong);cursor:pointer}.fm__frame{display:grid;grid-template-columns:minmax(13rem,17rem) minmax(0,1fr);min-height:calc(100vh - 3.75rem)}
  .fm__nav{position:sticky;top:3.75rem;align-self:start;max-height:calc(100vh - 3.75rem);overflow:auto;padding:1.25rem .9rem;background:var(--gw-v2-surface-muted);border-right:1px solid var(--gw-v2-seam)}.fm__nav-item{display:grid;grid-template-columns:1.8rem 1fr;gap:.55rem;padding:.7rem .55rem;border-left:2px solid transparent}.fm__nav-item.is-active{background:var(--gw-v2-signal-soft);border-left-color:var(--gw-v2-signal)}.fm__nav-item>span,.fm__nav-item small{color:var(--gw-v2-text-muted)}.fm__nav-item div{display:grid;gap:.15rem}.fm__note{margin-top:1rem;padding:.75rem;background:var(--gw-v2-surface);border:1px solid var(--gw-v2-seam)}
  .fm__main{min-width:0;padding:clamp(1.25rem,3vw,3rem)}.fm__hero{display:grid;align-content:center;gap:1rem;min-height:min(50vh,30rem);padding:clamp(1.5rem,4vw,4rem);background:var(--gw-v2-surface);border:1px solid var(--gw-v2-seam);box-shadow:var(--gw-v2-elevation-1)}.fm__hero:before{width:7rem;height:.3rem;content:"";background:var(--gw-v2-brand-spectrum,var(--gw-v2-signal))}.fm__hero h1{max-width:18ch;font-size:var(--gw-v2-type-2xl)}.fm__hero>p:last-child{max-width:66ch;color:var(--gw-v2-text-muted);font-size:var(--gw-v2-type-lg)}
  .fm__section{display:grid;gap:1.25rem;padding-block:clamp(2.5rem,6vw,5rem);border-bottom:1px solid var(--gw-v2-seam)}.fm__section>header{display:grid;gap:.45rem}.fm__section h2{font-size:var(--gw-v2-type-xl)}.fm__grid,.fm__states{display:grid;grid-template-columns:repeat(auto-fit,minmax(min(100%,17rem),1fr));gap:.75rem}.fm__grid article,.fm__states article,.fm__layers article,.fm__surfaces>article{min-width:0;padding:1rem;background:var(--gw-v2-surface);border:1px solid var(--gw-v2-seam)}.fm__grid article>header{display:flex;justify-content:space-between;gap:.5rem}.fm__grid article>p,.fm__states small,.fm__layers small{color:var(--gw-v2-text-muted)}.fm__grid dl{display:grid;gap:.35rem}.fm__grid dl div{display:grid;grid-template-columns:4rem 1fr;gap:.5rem}.fm__grid dd{margin:0}.fm__states article{border-top:3px solid var(--gw-v2-seam-strong)}.fm__states [data-state="waiting-for-approval"]{border-top-color:var(--gw-v2-state-warning)}.fm__states [data-state="failed"]{border-top-color:var(--gw-v2-state-danger)}
  .fm__journey,.fm__truth{display:grid;grid-template-columns:repeat(auto-fit,minmax(12rem,1fr));margin:0;padding:0;list-style:none;gap:.5rem}.fm__journey li,.fm__truth li{padding:1rem;background:var(--gw-v2-surface-recessed);border:1px solid var(--gw-v2-seam)}.fm__journey li{display:grid;grid-template-columns:auto 1fr;gap:.7rem}.fm__journey li>span{width:1.7rem;height:1.7rem;display:grid;place-items:center;color:var(--gw-v2-on-signal);background:var(--gw-v2-signal);border-radius:50%}.fm__journey div{display:grid;gap:.3rem}.fm__journey small{color:var(--gw-v2-text-muted)}
  .fm__relations{display:grid;gap:.5rem}.fm__relations article{display:grid;grid-template-columns:minmax(7rem,auto) auto minmax(7rem,auto) 1fr;align-items:center;gap:.75rem;padding:.8rem 1rem;background:var(--gw-v2-surface);border:1px solid var(--gw-v2-seam)}.fm__relations span{color:var(--gw-v2-brand-violet,var(--gw-v2-signal))}.fm__relations p{color:var(--gw-v2-text-muted)}.fm__layers,.fm__surfaces{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:.75rem}.fm__surfaces ul{display:grid;gap:.5rem;margin:1rem 0 0;padding:0;list-style:none}.fm__surfaces li{display:grid;gap:.2rem;padding-top:.5rem;border-top:1px solid var(--gw-v2-seam)}.fm__surfaces code,.fm__surfaces small{color:var(--gw-v2-text-muted);overflow-wrap:anywhere}
  @media(max-width:52rem){.fm__frame{display:block}.fm__nav{position:static;max-height:none;border-right:0;border-bottom:1px solid var(--gw-v2-seam)}.fm__relations article{grid-template-columns:1fr auto 1fr}.fm__relations p{grid-column:1/-1}.fm__layers,.fm__surfaces{grid-template-columns:1fr}}
  @media(max-width:36rem){.fm__bar{position:static}.fm__main{padding:1rem}.fm__hero{padding:1.25rem}.fm__relations article{grid-template-columns:1fr}.fm__relations p{grid-column:auto}}
  @media(prefers-reduced-motion:reduce){.fm__skip,.fm *{scroll-behavior:auto!important;transition:none!important}}
</style>
