---
import {
  greenwaysV2Workflows,
  greenwaysV2WorkflowStates,
} from "../../../../v2/component-catalogue.js";
import "../../../../v2/library.css";

const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
type WorkflowDefinition = (typeof greenwaysV2Workflows)[number];
type StateDefinition = (typeof greenwaysV2WorkflowStates)[number];
const workflows = greenwaysV2Workflows as readonly WorkflowDefinition[];
const states = greenwaysV2WorkflowStates as readonly StateDefinition[];
const cueFor = (id: string) => ({
  "empty-first-use": "○",
  "empty-filtered": "0",
  loading: "…",
  stale: "↻",
  partial: "½",
  offline: "×",
  "recoverable-error": "!",
  "fatal-error": "■",
  "waiting-approval": "?",
  active: "▶",
  success: "✓",
}[id] ?? "·");
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Greenways v2 workflow and difficult-state laboratory." />
    <title>Greenways v2 workflow states</title>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem("greenways-v2-theme");
          document.documentElement.dataset.theme = stored || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        } catch { document.documentElement.dataset.theme = "light"; }
      })();
    </script>
  </head>
  <body class="gw-v2 gw-v2-library">
    <header class="gw-v2-library__bar">
      <a class="gw-v2-library__identity" href={`${base}v2/`}><strong>Greenways v2</strong><small>Workflow states</small></a>
      <nav class="gw-v2-library__nav" aria-label="Interface library">
        <a href={`${base}v2/library/`}>Overview</a>
        <a href={`${base}v2/library/components/`}>Components</a>
        <a aria-current="page" href={`${base}v2/library/workflows/`}>Workflow states</a>
        <button class="gw-v2-specimen-control" type="button" data-theme-toggle>Theme</button>
      </nav>
    </header>

    <main class="gw-v2-library__main">
      <section class="gw-v2-library__hero">
        <p class="gw-v2-library__eyebrow">Desired state ≠ observed state</p>
        <h1>The difficult states<br />are part of the product.</h1>
        <p>Every study keeps the current step, evidence and safe next action visible. A toggle, request or provider login never stands in for completion or authority.</p>
      </section>

      <section class="gw-v2-library__section" aria-labelledby="workflow-studies" data-gw-v2-workflow-catalogue>
        <header><p class="gw-v2-library__eyebrow">Composed studies</p><h2 id="workflow-studies">Four repeatable workflow shapes.</h2></header>
        <div class="gw-v2-workflow-grid">
          {workflows.map((workflow) => (
            <article class="gw-v2-workflow" data-gw-v2-workflow={workflow.id}>
              <p class="gw-v2-workflow__meta">Shared composition · application-owned execution</p>
              <h3>{workflow.label}</h3>
              <ol class="gw-v2-workflow__steps" aria-label={`${workflow.label} steps`}>
                {workflow.steps.map((step, index) => <li>{String(index + 1).padStart(2, "0")} · {step}</li>)}
              </ol>
              <p><strong>Evidence:</strong> {workflow.evidence}</p>
              <small>{workflow.applicationBoundary}</small>
            </article>
          ))}
        </div>
      </section>

      <section class="gw-v2-library__section" aria-labelledby="state-specimens" data-gw-v2-state-catalogue>
        <header><p class="gw-v2-library__eyebrow">Required state inventory</p><h2 id="state-specimens">Eleven states with non-colour cues.</h2><p>Border style and colour supplement explicit labels, evidence and actions; they never carry meaning alone.</p></header>
        <div class="gw-v2-state-grid">
          {states.map((state) => (
            <article class="gw-v2-state" data-state={state.id} data-gw-v2-state={state.id}>
              <div class="gw-v2-state__cue" data-cue={cueFor(state.id)}><h3>{state.label}</h3></div>
              <p>{state.meaning}</p>
              <dl>
                <div><dt>Evidence</dt><dd>{state.evidence}</dd></div>
                <div><dt>Safe action</dt><dd>{state.nextAction}</dd></div>
                <div><dt>Non-colour cue</dt><dd>{state.nonColourCue}</dd></div>
              </dl>
            </article>
          ))}
        </div>
      </section>

      <section class="gw-v2-library__section" aria-labelledby="truthful-connection">
        <header><p class="gw-v2-library__eyebrow">Connection specimen</p><h2 id="truthful-connection">Configured, observed and authorised are different.</h2></header>
        <div class="gw-v2-component-grid">
          <article class="gw-v2-component"><p class="gw-v2-component__meta">Desired</p><h3>Provider configured</h3><p>The user asked Foreman to use this connection.</p><span data-gw-v2-state="neutral">Configuration saved</span></article>
          <article class="gw-v2-component"><p class="gw-v2-component__meta">Observed</p><h3>Connection offline</h3><p>Last successful observation was 18 minutes ago.</p><button class="gw-v2-specimen-control" type="button">Reconnect</button></article>
          <article class="gw-v2-component"><p class="gw-v2-component__meta">Authority</p><h3>Mutation not authorised</h3><p>Login does not grant issue creation, push, review or merge permission.</p><button class="gw-v2-specimen-control" data-primary="true" type="button">Review exact request</button></article>
        </div>
      </section>
    </main>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector("[data-theme-toggle]");
        const sync = () => button?.setAttribute("aria-label", root.dataset.theme === "dark" ? "Switch to light theme" : "Switch to dark theme");
        button?.addEventListener("click", () => {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          try { localStorage.setItem("greenways-v2-theme", root.dataset.theme); } catch {}
          sync();
        });
        sync();
      })();
    </script>
  </body>
</html>
