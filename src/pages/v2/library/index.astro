---
import CatalogueNavigation from "../../../v2/CatalogueNavigation.astro";
import CataloguePageFooter from "../../../v2/CataloguePageFooter.astro";
import GreenwaysThemeProvider from "../../../site/components/GreenwaysThemeProvider.astro";
import greenwaysV2DelicateMaterialCss from "../../../v2/catalogue-material.css?raw";
import "../../../v2/library.css";
import "../../../v2/catalogue-atlas.css";
const base = `${import.meta.env.BASE_URL.replace(/\/+$/, "")}/`;
---

<!doctype html>
<html lang="en" data-project="visual-language" data-gw-v2-atlas-frame>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content="Greenways v2 shared component and workflow-state laboratory." />
    <title>Greenways v2 interface library</title>
    <GreenwaysThemeProvider />
    <style
      is:inline
      data-greenways-v2-delicate-material
      set:html={greenwaysV2DelicateMaterialCss}
    ></style>
  </head>
  <body
    class="gw-v2 gw-v2-library gw-v2-catalogue gw-v2-atlas-frame"
    data-gw-v2-current-path="/v2/library/"
    data-gw-v2-material="delicate"
  >
    <CatalogueNavigation currentPath="/v2/library/" />
    <header class="gw-v2-library__bar">
      <a class="gw-v2-library__identity" href={`${base}v2/`}><strong>Greenways v2</strong><small>Interface library</small></a>
      <nav class="gw-v2-library__nav" aria-label="Interface library">
        <a aria-current="page" href={`${base}v2/library/`}>Overview</a>
        <a href={`${base}v2/library/components/`}>Components</a>
        <a href={`${base}v2/library/workflows/`}>Workflow states</a>
      </nav>
    </header>

    <main id="gw-v2-main" class="gw-v2-library__main" tabindex="-1">
      <section id="library-overview" data-catalogue-section data-section-label="Overview" class="gw-v2-library__hero">
        <p class="gw-v2-library__eyebrow">Issue #34 · shared visual contract</p>
        <h1>Reusable structures.<br />Truthful states.</h1>
        <p>The library defines accessible visual semantics for calm product surfaces and dense workbenches. Applications retain ownership of data, commands, validation, authority and effects.</p>
      </section>

      <section id="library-routes" data-catalogue-section data-section-label="Laboratories" class="gw-v2-library__section" aria-labelledby="library-routes-heading">
        <header><p class="gw-v2-library__eyebrow">Two laboratories</p><h2 id="library-routes-heading">Shared contracts before application composition.</h2></header>
        <div class="gw-v2-component-grid">
          <article class="gw-v2-component" data-gw-v2-component="catalogue-link">
            <p class="gw-v2-component__meta">21 stable component definitions</p>
            <h3>Component catalogue</h3>
            <p>Navigation, actions, fields, content, data, feedback, approvals, receipts and workbench regions.</p>
            <a href={`${base}v2/library/components/`}>Review components →</a>
          </article>
          <article class="gw-v2-component" data-gw-v2-component="catalogue-link">
            <p class="gw-v2-component__meta">4 workflows · 11 state specimens</p>
            <h3>Workflow states</h3>
            <p>Initial, active, waiting, stale, partial, offline, recoverable, fatal and evidenced success states.</p>
            <a href={`${base}v2/library/workflows/`}>Review workflows →</a>
          </article>
        </div>
      </section>

      <section id="ownership-boundary" data-catalogue-section data-section-label="Ownership" class="gw-v2-library__section" aria-labelledby="ownership-boundary-heading">
        <header><p class="gw-v2-library__eyebrow">Ownership boundary</p><h2 id="ownership-boundary-heading">Visual language is not application behaviour.</h2></header>
        <div class="gw-v2-component-grid">
          <article class="gw-v2-component"><h3>Shared visual contract</h3><p>Semantic markup, state markers, focus, density, responsive collapse and non-colour cues.</p></article>
          <article class="gw-v2-component"><h3>Application-owned behaviour</h3><p>Routing, commands, validation, providers, persistence, authority, execution and verified external effects.</p></article>
        </div>
      </section>
      <CataloguePageFooter currentPath="/v2/library/" />
    </main>
  </body>
</html>
