---
import type { GreenwaysV2CatalogueRoute } from "../../v2/catalogue-manifest";
import CatalogueShell from "../../v2/CatalogueShell.astro";
import {
  catalogueHref,
  catalogueOwnershipLabels,
  catalogueStatusLabels,
  getCataloguePlaceholderRoutes,
} from "../../v2/catalogue-manifest.js";

export function getStaticPaths() {
  return getCataloguePlaceholderRoutes().map((route) => ({
    params: { route: route.path.replace(/^\/v2\//, "").replace(/\/$/, "") },
    props: { route },
  }));
}

interface Props { route: GreenwaysV2CatalogueRoute; }
const { route } = Astro.props;
const basePath = import.meta.env.BASE_URL;
const href = (path: string) => catalogueHref(path, basePath);
---
<CatalogueShell title={route.label} description={route.summary} currentPath={route.path}>
  <header class="gw-v2-route-hero" data-route-id={route.id} data-route-status={route.status}>
    <p class="gw-v2-route-meta">Greenways v2 catalogue</p>
    <h1>{route.label}</h1>
    <p>{route.summary}</p>
    <div class="gw-v2-route-badges" aria-label="Route status and ownership">
      <span>{catalogueStatusLabels[route.status]}</span>
      <span>{catalogueOwnershipLabels[route.ownership]}</span>
      {route.issue && <span>Issue #{route.issue}</span>}
    </div>
  </header>
  <section class="gw-v2-route-placeholder" aria-labelledby="gw-v2-route-next">
    <h2 id="gw-v2-route-next">Declared now. Detailed later.</h2>
    <p>This route is registered by the shared manifest so navigation, ownership, and status are stable before its later laboratory issue adds detailed specimens. No application behaviour is implemented here.</p>
    {route.issue && <p>Delivery is tracked in <a href={`https://github.com/greenways-ai/visual-language/issues/${route.issue}`}>issue #{route.issue}</a>.</p>}
    {route.children && route.children.length > 0 && (
      <nav aria-label={`${route.label} routes`}>
        <h3>Nested routes</h3>
        <ul>{route.children.map((child) => <li><a href={href(child.path)}>{child.label} →</a></li>)}</ul>
      </nav>
    )}
  </section>
</CatalogueShell>
