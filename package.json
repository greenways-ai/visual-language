{
  "name": "@greenways-ai/visual-language",
  "version": "5.1.0",
  "description": "Adaptive mosaic visual language for Greenways sites.",
  "type": "module",
  "license": "Apache-2.0",
  "files": [
    "src",
    "assets",
    "bin",
    "BRAND-ASSETS.md",
    "V2-PACKAGE.md",
    "V2-MIGRATION.md",
    "NOTICE"
  ],
  "exports": {
    "./theme.css": "./src/theme.css",
    "./typography.css": "./src/typography.css",
    "./theme.js": "./src/theme.js",
    "./ThemeToggle.astro": "./src/ThemeToggle.astro",
    "./ThemeMenu.astro": "./src/ThemeMenu.astro",
    "./ThemeButton.astro": "./src/ThemeButton.astro",
    "./SharedHeader.astro": "./src/SharedHeader.astro",
    "./DocumentationHeader.astro": "./src/DocumentationHeader.astro",
    "./DocumentationSearch.astro": "./src/DocumentationSearch.astro",
    "./ProjectSwitcher.astro": "./src/ProjectSwitcher.astro",
    "./CodePanel.astro": "./src/CodePanel.astro",
    "./DocumentationCard.astro": "./src/DocumentationCard.astro",
    "./Sigil.astro": "./src/Sigil.astro",
    "./projects.js": "./src/projects.js",
    "./MosaicLogo.astro": "./src/MosaicLogo.astro",
    "./ThemedArtwork.astro": "./src/ThemedArtwork.astro",
    "./statstrade.css": "./src/statstrade.css",
    "./statstrade-world.js": "./src/statstrade-world.js",
    "./StatstradeS.astro": "./src/StatstradeS.astro",
    "./StatstradeGateway.astro": "./src/StatstradeGateway.astro",
    "./v2/tokens.css": "./src/v2/tokens.css",
    "./v2/document.css": "./src/v2/document.css",
    "./v2/workbench.css": "./src/v2/workbench.css",
    "./v2/components.css": "./src/v2/components.css",
    "./v2/contract.js": "./src/v2/contract.js",
    "./v2/component-catalogue.js": "./src/v2/component-catalogue.js",
    "./v2/component-contract.js": "./src/v2/component-contract.js",
    "./v2/astro/Navigation.astro": "./src/v2/astro/Navigation.astro",
    "./v2/astro/Action.astro": "./src/v2/astro/Action.astro",
    "./v2/astro/Toggle.astro": "./src/v2/astro/Toggle.astro",
    "./v2/astro/Field.astro": "./src/v2/astro/Field.astro",
    "./v2/astro/Tabs.astro": "./src/v2/astro/Tabs.astro",
    "./v2/astro/FilterBar.astro": "./src/v2/astro/FilterBar.astro",
    "./v2/astro/List.astro": "./src/v2/astro/List.astro",
    "./v2/astro/Card.astro": "./src/v2/astro/Card.astro",
    "./v2/astro/DataTable.astro": "./src/v2/astro/DataTable.astro",
    "./v2/astro/Panel.astro": "./src/v2/astro/Panel.astro",
    "./v2/astro/Dialog.astro": "./src/v2/astro/Dialog.astro",
    "./v2/astro/Status.astro": "./src/v2/astro/Status.astro",
    "./v2/astro/ActivityList.astro": "./src/v2/astro/ActivityList.astro",
    "./v2/astro/ApprovalCard.astro": "./src/v2/astro/ApprovalCard.astro",
    "./v2/astro/Receipt.astro": "./src/v2/astro/Receipt.astro",
    "./v2/astro/WorkbenchShell.astro": "./src/v2/astro/WorkbenchShell.astro"
  },
  "bin": {
    "gw-visual-audit": "./bin/gw-visual-audit.mjs",
    "gw-sync-favicon": "./bin/gw-sync-favicon.mjs"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "check": "ASTRO_TELEMETRY_DISABLED=1 astro check",
    "assets": "node bin/generate-v3-favicons.mjs",
    "assets:catalogue": "node scripts/build-asset-catalogue.mjs",
    "stage:catalogue-bundle": "node scripts/stage-asset-catalogue-bundle.mjs",
    "stage:catalogue-seed": "node scripts/stage-asset-catalogue-seed.mjs",
    "verify:catalogue": "node scripts/verify-asset-catalogue.mjs",
    "sigils": "node bin/generate-sigil-explorations.mjs",
    "prompts": "node bin/compose-scene-prompts.mjs",
    "artwork:raster": "node bin/build-raster-artwork.mjs",
    "artwork": "node bin/generate-artwork.mjs",
    "build": "npm run assets && npm run og:optimize && npm run assets:catalogue && ASTRO_TELEMETRY_DISABLED=1 astro check && ASTRO_TELEMETRY_DISABLED=1 astro build && node scripts/copy-static-assets.mjs && npm run verify:site",
    "build:site": "npm run build",
    "verify:site": "node scripts/verify-site-output.mjs && node scripts/verify-greenways-os-v2-output.mjs",
    "test": "npm run assets && npm run verify:catalogue && node --test test/*.test.mjs",
    "og": "node bin/generate-og-images.mjs && npm run og:optimize",
    "og:optimize": "node bin/optimize-og-images.mjs"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^7.0.5",
    "@astrojs/starlight": "^0.41.6",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/manrope": "^5.2.7",
    "@fontsource/marcellus": "^5.2.6",
    "astro": "^7.1.6",
    "sharp": "^0.35.3",
    "typescript": "^5.9.2"
  },
  "peerDependencies": {
    "astro": ">=5.0.0"
  },
  "peerDependenciesMeta": {
    "astro": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22"
  }
}
